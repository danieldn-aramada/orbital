{
 "__inputs": [],
 "__requires": [],
 "annotations": {
  "list": []
 },
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "tags": [
  "orbital",
  "devcc"
 ],
 "title": "Orbital (devcc)",
 "uid": "orbital-devcc",
 "timezone": "",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Cortex",
     "value": "cortex"
    },
    "hide": 0,
    "regex": "",
    "refresh": 1
   },
   {
    "name": "path",
    "label": "Path",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(http_requests_total{job=\"scrape-orbital\"}, path)",
     "refId": "path"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "hide": 0,
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Async jobs (export, publish, restore) \u2014 NOT visible in HTTP metrics",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Job failures (in range)",
   "description": "Every async job failure in the range. An async job's trigger returns 202 and the work fails later, so NONE of the HTTP panels below can see this \u2014 on 2026-10-09 a broken publish ran ~40min against a fully green dashboard. 0 = healthy.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(orbital_job_failures_total{job=\"scrape-orbital\"}[$__range])) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Time since last successful publish",
   "description": "Seconds since a publish last SUCCEEDED. A failure counter only moves when someone tries; this is what catches publishing having quietly stopped. Red past 24h \u2014 raise it if this environment republishes less often than daily.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - max(orbital_job_last_success_timestamp_seconds{job=\"scrape-orbital\",operation=\"publish\"})) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 86400
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Job failures by operation and reason",
   "description": "The panel that NAMES an incident. reason is classified structurally at the call site: dependency_rejected = another service answered with an error (look at that service, not at orbital); dependency_unreachable = could not connect; lease_lost = the runner stopped heartbeating; internal = orbital has not classified it yet.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (operation, reason) (increase(orbital_job_failures_total{job=\"scrape-orbital\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{operation}} \u00b7 {{reason}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "sum"
     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Job success ratio by operation",
   "description": "Succeeded / all terminal jobs, per operation. Gaps mean nothing ran in that window \u2014 read it next to the freshness stat, which is what distinguishes idle from broken.",
   "gridPos": {
    "h": 4,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (operation) (increase(orbital_jobs_total{job=\"scrape-orbital\",outcome=\"succeeded\"}[$__rate_interval]))\n/ clamp_min(sum by (operation) (increase(orbital_jobs_total{job=\"scrape-orbital\"}[$__rate_interval])), 1)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{operation}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "type": "row",
   "title": "HTTP RED (request-level golden signals)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "stat",

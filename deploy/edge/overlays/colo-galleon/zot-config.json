{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000"
  },
  "log": {
    "level": "warn"
  },
  "scheduler": {
    "numWorkers": 3
  },
  "extensions": {
    "ui": { "enable": true },
    "search": { "enable": true },
    "trust": { "enable": true, "cosign": true },
    "sync": {
      "credentialsFile": "/etc/zot/sync-creds.json",
      "registries": [{
        "urls": ["https://armadaeksatest.azurecr.io"],
        "onDemand": false,
        "tlsVerify": true,
        "pollInterval": "10s",
        "SyncLegacyCosignTags": true,
        "content": [{
          "prefix": "orbital/colo-galleon/**",
          "tags": {
            "regex": "^v(7[0-9]|[89][0-9]|[1-9][0-9]{2,})$"
          }
        }]
      }]
    }
  }
}

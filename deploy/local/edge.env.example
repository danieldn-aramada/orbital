# Edge sim environment for `make edge-up`.
#
# Copy this file to `edge.env` (gitignored) and fill in the secret. orb's
# docker-compose.edge.yml reads from edge.env via env_file:, so values appear
# inside the orb container as process env.

# ── Azure Blob target for divergence publishing ──────────────────────────────
# Must match the same storage account orbital uses in AKS so the divergence
# loop can close (orb publishes → orbital ingests). The secret is the storage
# account key — paste from your dev-netbox/secrets.yaml ORBITAL_S3_SECRET_KEY
# entry.
ORB_S3_ENDPOINT=https://armadagalleonbackups.blob.core.windows.net
ORB_S3_BUCKET=cmdb
ORB_S3_ACCESS_KEY=armadagalleonbackups
ORB_S3_SECRET_KEY=REPLACE_WITH_AZURE_STORAGE_ACCOUNT_KEY

# ── DC identity ──────────────────────────────────────────────────────────────
# Which orbital DC this orb instance is acting as. Must match an OCI repo
# orbital has published to ACR. Examples seen in this repo:
#   orbital/colo-galleon
#   orbital/alaska-dot-galleon
#   orbital/alaska-dot-cruiser
ORB_OCI_REPO=orbital/colo-galleon

# ── cb-controller dispatch endpoints ─────────────────────────────────────────
# `host.docker.internal` resolves to the macOS host from inside the orb
# container — cb-controller runs on the host via `make run-controller` in the
# configbundle repo.
#
# Single JSON array; each entry maps a layer media type to an HTTP receiver.
# Add more entries here if a future bundle ships additional layers.
ORB_CONSUMERS=[{"name":"cb-controller","url":"http://host.docker.internal:8095/dispatch"}]

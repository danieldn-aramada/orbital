<div id="cfg-delete-modal" class="modal modal-fx-3dRotateFromBottom">
  <div class="modal-background"></div>
  <div class="modal-content modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title" id="cfg-delete-modal-title">Delete</p>
      <button class="delete js-cfg-delete-close" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <div id="cfg-delete-modal-loading" class="has-text-grey">Loading impact summary…</div>
      <div id="cfg-delete-modal-body" style="display:none"></div>
      <div id="cfg-delete-modal-error" class="has-text-danger" style="display:none"></div>
    </section>
    <footer class="modal-card-foot">
      <div class="buttons">
        <button id="cfg-delete-confirm-btn" class="button is-danger" disabled>Delete</button>
        <button class="button js-cfg-delete-close">Cancel</button>
      </div>
    </footer>
  </div>
</div>

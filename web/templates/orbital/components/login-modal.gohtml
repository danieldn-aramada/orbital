<div id="login-modal" class="modal modal-fx-3dRotateFromBottom{{if .LoginError}} is-active{{end}}">
  <div class="modal-background" data-modal-close></div>
  <div class="modal-content">
    <div class="box">
      <p class="has-text-weight-semibold is-size-5 mb-4">
        <span class="icon-text">
          <span class="icon"><i class="fa-solid fa-satellite-dish"></i></span>
          <span>Orbital Login</span>
        </span>
      </p>

    {{if .LoginError}}
    <div class="notification is-danger is-light py-3 px-4 mb-4 is-size-7">
      {{if .LoginErrorCode}}<code class="has-text-danger mr-1">{{.LoginErrorCode}}</code>{{end}}{{.LoginError}}
    </div>
    {{end}}

    {{if .OIDCEnabled}}
    <a href="{{.BasePath}}/auth/login" class="button is-fullwidth mb-4" style="gap: 0.5rem;">
      {{if .OIDCIconURL}}
      <span class="icon"><img src="{{.OIDCIconURL}}" alt="" style="width:18px;height:18px;"></span>
      {{else}}
      <span class="icon"><i class="fa-solid fa-right-to-bracket"></i></span>
      {{end}}
      <span>Sign in with {{.OIDCDisplayName}}</span>
    </a>
    <div class="is-divider" data-content="OR"></div>
    {{end}}

    <form id="form-login" hx-post="{{.BasePath}}/user/login" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']">

      <div class="field">
        <label class="label">Email</label>
        <div class="control has-icons-left">
          <input
            type="email"
            class="input"
            name="email"
            placeholder="user@example.com"
            autocomplete="on"
          />
          <span class="icon is-small is-left">
            <i class="fas fa-envelope"></i>
          </span>
        </div>
      </div>

      <div class="field">
        <label class="label">Password</label>
        <div class="control has-icons-left">
          <input
            type="password"
            class="input"
            name="password"
            placeholder="password"
            autocomplete="on"
          />
          <span class="icon is-small is-left">
            <i class="fas fa-lock"></i>
          </span>
        </div>
      </div>

      <input type="hidden" name="csrf" value="{{.CsrfToken}}"/>

      <div class="field">
        <div class="control">
          <button class="button is-link" type="submit">Sign in</button>
        </div>
      </div>

    </form>

  </div>
  <button class="modal-close is-large" aria-label="close" data-modal-close></button>
</div>

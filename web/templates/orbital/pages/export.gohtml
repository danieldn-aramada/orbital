{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if not .IsAuthn}}
        <div class="notification is-warning is-light">
          <a class="js-modal-trigger" data-target="login-modal">Login</a> to view this page.
        </div>
      {{else}}

      {{if not .CanMutate}}{{template "access-required" .}}{{end}}

      <p class="is-size-4 mb-2" data-testid="page-heading">Export Subgraph</p>

      {{if .CanMutate}}
      <form id="form-export-subgraph" style="max-width: 520px;">
        <div class="field">
          <label class="label">
            Data Center
            <span class="has-text-danger">*</span>
          </label>
          <div class="control">
            <div class="select">
              <select id="export-datacenter-select" name="datacenterId">
                {{if .DataCenters}}
                  <option value="" disabled selected>— select a data center —</option>
                  {{range .DataCenters}}
                    <option value="{{.OrbID}}" data-name="{{.Name}}">{{.Name}}</option>
                  {{end}}
                {{else}}
                  <option value="" disabled selected>No data centers found</option>
                {{end}}
              </select>
            </div>
          </div>
        </div>

        <div class="field mt-4">
          <label class="label">
            Destination
            <span class="has-text-danger">*</span>
          </label>
          <div class="control">
            <div class="select">
              {{/* Destination options carry the target URL/label as their
                   visible text. OCI option's label is templated with the
                   selected DC name at page-render time (blank until DC is
                   picked) and re-rendered by JS whenever the DC changes.
                   data-oci-registry-prefix drives that JS. */}}
              <select id="export-destination-select" name="destination"
                      data-oci-registry-prefix="{{if .OCIConfigured}}{{.OCIRegistry}}/{{.OCIRepo}}/{{end}}">
                {{/* OCI is pre-selected when configured (the 99% case).
                     Non-OCI deployments fall back to Download by default —
                     Publish isn't reachable there anyway. */}}
                {{if .OCIConfigured}}
                <option value="oci" data-oci="true" selected>{{.OCIRegistry}}/{{.OCIRepo}}/{datacenter-name}</option>
                <option value="download">Download zip locally</option>
                {{else}}
                <option value="oci" data-oci="true" disabled>Publish to OCI (not configured)</option>
                <option value="download" selected>Download zip locally</option>
                {{end}}
              </select>
            </div>
          </div>
          {{/* Test Connection appears here only when OCI destination is
               selected. Plain inline styles (no Bulma is-flex) so JS can
               toggle display without a specificity/!important collision.
               Row is hidden by default; JS shows it as inline-flex. */}}
          <div id="test-connection-row" class="control mt-2" style="display: none; gap: 0.75rem; align-items: center;">
            <button id="btn-test-connection" type="button" class="button is-light is-small js-oci-test-connection">
              <span class="icon"><i class="fa-solid fa-plug"></i></span>
              <span>Test Connection</span>
            </button>
            <span id="test-connection-result" class="is-size-7"></span>
          </div>
        </div>

        <div class="field is-grouped mt-5">
          <div class="control">
            <button id="export-submit-btn" class="button is-primary js-export-submit" type="button" disabled>
              <span class="icon"><i class="fa-solid fa-file-export"></i></span>
              <span>Export Subgraph</span>
            </button>
          </div>
          {{/* Opens the SAME review modal the publish flow uses, minus the
               Confirm button — a way to answer "is there anything to publish?"
               without touching the control that publishes. Enabled on data
               centre alone: a preview is current graph vs last published
               artifact, so the destination is irrelevant to it, and the download
               destination has no review step of its own. */}}
          <div class="control">
            <button id="export-preview-btn" class="button is-light js-export-preview" type="button" disabled>
              <span class="icon"><i class="fa-solid fa-magnifying-glass"></i></span>
              <span>Preview changes</span>
            </button>
          </div>
          <div class="control">
            <a class="button is-light" href="{{.BasePath}}/">Cancel</a>
          </div>
        </div>
      </form>

      {{/* Phase-list progress. JS iterates .js-phase items and sets each
           icon+color based on its data-phase attribute vs the current
           job.phase from the poll response. In download mode (no OCI),
           JS hides the bundling/pushing/signing items so the operator
           doesn't see steps that will never run. */}}
      <div id="export-status-box" style="display:none; max-width: 520px;" class="mt-5">
        <article id="export-status-article" class="message">
          <div class="message-body" style="font-size: 0.875rem;">
            <ul id="export-phase-list" style="list-style:none;padding:0;margin:0;line-height:1.9">
              <li class="js-phase" data-phase="exporting">
                <span class="icon"><i class="fa-regular fa-circle has-text-grey-light"></i></span>
                <span>Exporting subgraph</span>
              </li>
              <li class="js-phase js-oci-only" data-phase="bundling">
                <span class="icon"><i class="fa-regular fa-circle has-text-grey-light"></i></span>
                <span>Bundling</span>
              </li>
              <li class="js-phase js-oci-only" data-phase="pushing">
                <span class="icon"><i class="fa-regular fa-circle has-text-grey-light"></i></span>
                <span>Pushing to registry</span>
              </li>
              <li class="js-phase js-oci-only" data-phase="signing">
                <span class="icon"><i class="fa-regular fa-circle has-text-grey-light"></i></span>
                <span>Signing</span>
              </li>
            </ul>
            <p id="export-status-summary" class="mt-2" style="display:none"></p>
          </div>
        </article>
      </div>

      {{/* Pre-publish review modal. Publishing to OCI opens this first: it shows
           the desired-state diff vs the last published artifact (Spike 30) so
           the operator never blind-publishes. Read-only — Confirm proceeds to
           the normal export/publish flow. Download-only exports skip it. */}}
      <div id="export-preview-modal" class="modal">
        <div class="modal-background" onclick="document.getElementById('export-preview-modal').classList.remove('is-active')"></div>
        <div class="modal-card" style="max-width: 1040px; width: 94%;">
          <header class="modal-card-head">
            <p class="modal-card-title">Review changes</p>
            <button class="delete" aria-label="close" onclick="document.getElementById('export-preview-modal').classList.remove('is-active')"></button>
          </header>
          <section class="modal-card-body">
            <div id="export-preview-body"></div>
          </section>
          <footer class="modal-card-foot" style="justify-content: flex-end; gap: 0.5rem;">
            <button id="export-preview-close" class="button" onclick="document.getElementById('export-preview-modal').classList.remove('is-active')">Cancel</button>
            <button id="export-preview-confirm" class="button is-primary" type="button" disabled>
              <span class="icon"><i class="fa-solid fa-cloud-arrow-up"></i></span>
              <span>Confirm &amp; Publish</span>
            </button>
          </footer>
        </div>
      </div>
      {{end}}

      {{/* Retained Downloads section — shows completed download-flow jobs whose
           on-disk zip is still available. Publish-flow rows are gone from this
           table (publish history lives at /publish-history). */}}
      <div class="mt-6">
        <div class="is-flex is-align-items-center mb-3" style="gap: 0.75rem;">
          <p class="is-size-5">Retained Downloads</p>
          <button class="button is-small is-link js-retained-reload" title="Reload">
            <span class="icon"><i class="fa-solid fa-rotate-right"></i></span>
            <span>Reload</span>
          </button>
        </div>
        <p class="has-text-grey mb-3" style="font-size: 0.8125rem;">
          Zips retained from Export &amp; Download. Each takes disk space until you download or delete it.
        </p>
        <div style="overflow-x: auto">
          <table
            id="export-jobs-table"
            class="table is-striped is-hoverable is-fullwidth is-size-7"
            data-oci-configured="{{if .OCIConfigured}}true{{else}}false{{end}}"
          >
            <thead>
              <tr>
                <th>Data Center</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Created By</th>
                <th>Completed At</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="export-jobs-tbody">
              <tr><td colspan="6" class="has-text-grey">No retained downloads.</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      {{end}}
    </div>
  </main>
{{end}}

{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if not .IsAuthn}}
        <div class="notification is-warning is-light">
          <a class="js-modal-trigger" data-target="login-modal">Login</a> to view this page.
        </div>
      {{else}}

      <p class="is-size-4 mb-2" data-testid="page-heading">Change Requests</p>
      <p class="has-text-grey mb-4" style="font-size: 0.875rem;">
        Proposed changes to configuration intent, reviewed against current intent before they apply.
      </p>

      <div id="cr-error" class="notification is-danger is-light" style="display:none;"></div>

      {{/* Do NOT add `is-small`: it makes these the only 12px tabs in the app. */}}
      <nav class="tabs is-boxed has-text-weight-medium" style="font-size: 14px;" id="cr-tabs">
        <ul>
          {{if .CanMutate}}<li class="is-active"><a data-cr-filter="awaiting_review=true">Needs my review</a></li>{{end}}
          <li{{if not .CanMutate}} class="is-active"{{end}}><a data-cr-filter="status=active">Open</a></li>
          <li><a data-cr-filter="status=merged&amp;status=rejected&amp;status=closed">Closed</a></li>
        </ul>
      </nav>

      <table class="table is-striped is-hoverable is-fullwidth is-size-7" id="cr-table">
        <colgroup>
          <col style="width:8%"><col style="width:30%"><col style="width:9%"><col style="width:10%">
          <col style="width:15%"><col style="width:10%"><col style="width:9%"><col style="width:9%">
        </colgroup>
        <thead>
          <tr>
            <th>ID</th><th>Title</th><th>Change</th><th>Namespace</th><th>Author</th>
            <th>Status</th><th>Approvals</th><th>Age</th>
          </tr>
        </thead>
        <tbody id="cr-tbody"></tbody>
      </table>

      <p id="cr-empty" class="has-text-grey is-size-7" style="display:none;"></p>

      {{end}}
    </div>
  </main>
{{end}}

{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if not .IsAuthn}}
        <div class="notification is-warning is-light">
          <a class="js-modal-trigger" data-target="login-modal">Login</a> to view this page.
        </div>
      {{else if ne .User.Role "admin"}}
        <div class="notification is-danger is-light">
          Admin access required.
        </div>
      {{else}}

      <p class="is-size-4 mb-2" data-testid="page-heading">Users</p>
      <p class="has-text-grey page-description">
        <strong>Readonly</strong> — view only.
        <strong>Dev</strong> — full config access (mutations, export, backup).
        <strong>Admin</strong> — dev access + role management.
      </p>

      <div id="users-error" class="notification is-danger is-light" style="display:none;"></div>

      <table class="table is-striped is-hoverable is-fullwidth is-size-7">
        <thead>
          <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Role</th>
            <th>Created At</th>
          </tr>
        </thead>
        <tbody>
          {{range .Users}}
          {{$self := eq .ID $.User.Id}}
          <tr data-user-id="{{.ID}}">
            <td>{{.Email}}</td>
            <td>{{if .Name}}{{.Name}}{{else}}—{{end}}</td>
            <td>
              {{if .ProviderOwned}}
              <span class="has-text-weight-semibold">{{.Role}}</span>
              <span class="is-size-7 has-text-grey ml-2 tooltip is-wide" data-text="Role comes from a group claim issued by {{.RoleSource}}, and is re-derived at every login. Change it in the identity provider.">from {{.RoleSourceLabel}}</span>
              {{else}}
              <div class="buttons has-addons" style="margin-bottom:0; flex-wrap:nowrap;">
                <button
                  class="button is-small tooltip js-user-role-set{{if eq .Role "readonly"}} is-primary is-selected{{end}}"
                  data-user-id="{{.ID}}"
                  data-role="readonly"
                  {{if or $self (eq .Role "readonly")}}disabled{{end}}
                  style="width:5rem;"
                 data-text="Readonly — view only">Readonly</button>
                <button
                  class="button is-small tooltip js-user-role-set{{if eq .Role "dev"}} is-warning is-selected{{end}}"
                  data-user-id="{{.ID}}"
                  data-role="dev"
                  {{if or $self (eq .Role "dev")}}disabled{{end}}
                  style="width:5rem;"
                 data-text="Dev — config access">Dev</button>
                <button
                  class="button is-small tooltip js-user-role-set{{if eq .Role "admin"}} is-danger is-selected{{end}}"
                  data-user-id="{{.ID}}"
                  data-role="admin"
                  {{if or $self (eq .Role "admin")}}disabled{{end}}
                  style="width:5rem;"
                 data-text="Admin — role management">Admin</button>
              </div>
              {{end}}
            </td>
            <td><span data-timestamp="{{.CreatedAt}}">{{.CreatedAt}}</span></td>
          </tr>
          {{else}}
          <tr><td colspan="4" class="has-text-grey">No users found.</td></tr>
          {{end}}
        </tbody>
      </table>

      {{end}}
    </div>
  </main>
{{end}}

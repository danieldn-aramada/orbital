{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if not .IsAuthn}}
        <div class="notification is-warning is-light">
          <a class="js-modal-trigger" data-target="login-modal">Login</a> to view this page.
        </div>
      {{else}}

      {{if not .CanMutate}}{{template "access-required" .}}{{end}}

      <p class="is-size-4 mb-2" data-testid="page-heading">Publish History</p>
      <p class="has-text-grey mb-4" style="font-size: 0.875rem;">
        Compare any two published artifacts of the same data center. Both sides are pulled from the registry by immutable digest, so this reflects exactly what was shipped.
      </p>

      {{template "publish-history-tabs" .}}

      {{/* Pickers are the empty state: landing here with no from/to still gives
           something to do, which is why Compare is a tab and not a hidden flow
           reachable only by ticking two checkboxes on the Artifacts tab. */}}
      <div class="is-flex is-align-items-flex-end mb-4" style="gap: 0.75rem; flex-wrap: wrap;">
        <div class="field mb-0">
          <label class="label is-small">Data center</label>
          <div class="control">
            <div class="select is-small">
              <select id="compare-dc-select"><option value="">Loading…</option></select>
            </div>
          </div>
        </div>
        <div class="field mb-0">
          <label class="label is-small">From</label>
          <div class="control">
            <div class="select is-small">
              <select id="compare-from-select" disabled><option value="">—</option></select>
            </div>
          </div>
        </div>
        <span class="has-text-grey mb-2"><i class="fa-solid fa-arrow-right"></i></span>
        <div class="field mb-0">
          <label class="label is-small">To</label>
          <div class="control">
            <div class="select is-small">
              <select id="compare-to-select" disabled><option value="">—</option></select>
            </div>
          </div>
        </div>
        <div class="field mb-0">
          <button id="btn-compare-run" class="button is-link is-small" disabled>
            <span class="icon"><i class="fa-solid fa-code-compare"></i></span>
            <span>Compare</span>
          </button>
        </div>
      </div>

      <div id="compare-result"></div>

      {{end}}
    </div>
  </main>
{{end}}

{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if not .IsAuthn}}
        <div class="notification is-warning is-light">
          <a class="js-modal-trigger" data-target="login-modal">Login</a> to view this page.
        </div>
      {{else}}

      <p class="is-size-4 mb-2" data-testid="page-heading">Divergence Reports</p>
      <p class="has-text-grey mb-5" style="font-size: 0.875rem;">
        One row per data center, latest snapshot orb published. Click to expand.{{if .CanResolve}} Stage Accept / Reject / Ignore on every field, then Submit — hover a button for what it does.{{end}}
      </p>

      <div class="field mb-3" style="max-width: 480px;">
        <label class="label is-small">Location</label>
        <div class="control has-icons-right">
          {{if .BackupEnabled}}
            <input class="input is-small has-background-light has-text-grey-dark" type="text" value="{{.S3Endpoint}}/{{.S3Bucket}}" readonly style="cursor: default;">
            <span class="icon is-small is-right has-text-grey-light"><i class="fas fa-lock"></i></span>
          {{else}}
            <input class="input is-small is-danger" type="text" value="Object store not configured" readonly style="cursor: default;">
            <p class="help is-danger">Set ORBITAL_S3_BUCKET, ORBITAL_S3_ACCESS_KEY, ORBITAL_S3_SECRET_KEY</p>
          {{end}}
        </div>
        {{if .BackupEnabled}}<p class="help has-text-grey-light">Configurable only via environment variable</p>{{end}}
      </div>

      <div class="field mb-4">
        <div class="control is-flex is-align-items-center" style="gap: 0.75rem;">
          <button id="btn-refresh-divergence" class="button is-info is-small" onclick="refreshDivergenceReports()">
            <span class="icon"><i class="fa-solid fa-rotate"></i></span>
            <span>Refresh</span>
          </button>
          <button id="btn-test-divergence-connection" type="button" class="button is-light is-small"
                  hx-post="{{.BasePath}}/api/v1/backup/test-connection"
                  hx-target="#divergence-connection-result"
                  hx-swap="innerHTML">
            <span class="icon"><i class="fa-solid fa-plug"></i></span>
            <span>Test Connection</span>
          </button>
          <span id="divergence-connection-result" class="is-size-7"></span>
        </div>
      </div>

      <div id="divergence-error" class="notification is-danger is-light" style="display:none;"></div>

      {{/* Refresh swaps the inner HTML of this div with the same {{define
           "divergence-content"}} fragment the server returns when called with
           HX-Request: true. */}}
      <div id="divergence-content">
        {{template "divergence-content" .}}
      </div>

      {{end}}
    </div>
  </main>

  <div id="divergence-confirm-modal" class="modal">
    <div class="modal-background" onclick="closeDivergenceConfirmModal()"></div>
    <div class="modal-card" style="max-width: 640px;">
      <header class="modal-card-head">
        <p class="modal-card-title is-size-6">Submit decisions</p>
        <button class="delete" aria-label="close" onclick="closeDivergenceConfirmModal()"></button>
      </header>
      <section class="modal-card-body">
        <div id="divergence-confirm-summary"></div>
      </section>
      <footer class="modal-card-foot is-flex is-justify-content-flex-end" style="gap:0.5rem;">
        <button class="button" onclick="closeDivergenceConfirmModal()">Cancel</button>
        <button id="divergence-confirm-btn" class="button is-primary" onclick="confirmDivergenceBatch()">Confirm</button>
      </footer>
    </div>
  </div>

  {{/* Reuses the same publish-confirm modal markup as /export: per-row button
       triggers export + opens this modal with the publish summary fragment.
       Operator confirms by clicking Publish in the modal — same HTMX form
       flow as the Export page. */}}
  <div id="publish-confirm-modal" class="modal">
    <div class="modal-background" onclick="document.getElementById('publish-confirm-modal').classList.remove('is-active')"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">Publish Export</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('publish-confirm-modal').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <div id="publish-modal-body"></div>
      </section>
      <footer class="modal-card-foot">
        <button class="button" onclick="document.getElementById('publish-confirm-modal').classList.remove('is-active')">Close</button>
      </footer>
    </div>
  </div>
{{end}}

{{define "divergence-content"}}
      <form id="divergence-batch-form" onsubmit="event.preventDefault(); submitDivergenceBatch();">
      <table class="table is-striped is-hoverable is-fullwidth is-size-7" style="table-layout: fixed;">
        <colgroup>
          <col style="width: 2.5rem">  {{/* chevron */}}
          <col style="width: 20%">      {{/* Data Center */}}
          <col style="width: 18%">      {{/* Last Seen */}}
          <col style="width: 10%">      {{/* Entries */}}
          <col style="width: 18%">      {{/* Status */}}
          <col>                         {{/* Actions — remainder */}}
        </colgroup>
        <thead>
          <tr>
            <th></th>
            <th>Data Center</th>
            <th>Last Seen</th>
            <th>Entries</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{range .Groups}}
          {{$dcId := .DCOrbID}}
          <tr class="divergence-group-row" data-dc="{{$dcId}}" onclick="toggleDivergenceGroup('{{$dcId}}', this)" style="cursor: pointer;">
            <td><span class="icon is-small"><i class="fas fa-chevron-right divergence-chevron"></i></span></td>
            <td>{{.DCOrbID}}</td>
            <td>{{.LastSeenAt}}</td>
            <td>{{.Total}}</td>
            <td>
              {{if gt .Pending 0}}
                <span class="tag is-warning">
                  <span class="icon is-small"><i class="fa-solid fa-circle-exclamation"></i></span>
                  <span>Needs review</span>
                </span>
              {{else if gt .Total 0}}
                <span class="tag is-success">
                  <span class="icon is-small"><i class="fa-solid fa-circle-check"></i></span>
                  <span>Reviewed</span>
                </span>
              {{end}}
            </td>
            <td onclick="event.stopPropagation()">
              {{/* Publish button: triggers export + publish for this DC in one
                   action. Three states:
                     1. Pending decisions exist → disabled, "Resolve first" tooltip.
                     2. AlreadyPublished (current resolutions already covered by
                        a completed publish, server-side check) → renders as a
                        green link to Publish History so the operator can see
                        when/who published before deciding to republish.
                     3. Otherwise → enabled outlined "Publish".
                   State (2) enforces one-shot publish semantics across all
                   operators / sessions. */}}
              {{if .AlreadyPublished}}
              <a class="button is-success is-light is-small"
                 href="{{.BasePath}}/publish-history"
                 title="View publish history">
                <span class="icon"><i class="fa-solid fa-check"></i></span>
                <span>Published{{if .PublishedTag}} {{.PublishedTag}}{{end}}</span>
                <span class="icon"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
              </a>
              {{else}}
              <button class="button is-link is-outlined is-small divergence-publish-btn"
                      data-dc-orbid="{{$dcId}}"
                      onclick="divergencePublishForDC(this)"
                      {{if gt .Pending 0}}disabled title="Resolve pending decisions first"{{end}}>
                <span class="icon"><i class="fa-solid fa-upload"></i></span>
                <span>Publish</span>
              </button>
              {{end}}
            </td>
          </tr>
          <tr class="divergence-group-detail" data-dc="{{$dcId}}" style="display:none;">
            <td></td>
            <td colspan="5">
              <table class="table is-fullwidth is-size-7" style="margin-bottom:0; table-layout: fixed;">
                <colgroup>
                  <col style="width: 15%">    {{/* Config Item: type + orbId stacked */}}
                  <col style="width: 15%">    {{/* Field */}}
                  <col style="width: 10%">     {{/* Intended */}}
                  <col style="width: 10%">     {{/* Override */}}
                  <col style="width: 10%">    {{/* Who */}}
                  <col style="width: 15%">    {{/* First Seen */}}
                  <col>                       {{/* Decision — remainder; holds action buttons when pending */}}
                </colgroup>
                <thead>
                  <tr>
                    <th>Config Item</th>
                    <th>Field</th>
                    <th>Intended</th>
                    <th>Override</th>
                    <th>Who</th>
                    <th>First Seen</th>
                    <th>Decision</th>
                  </tr>
                </thead>
                <tbody>
                  {{range .Rows}}
                  <tr data-entry-id="{{.ID}}">
                    <td>
                      {{if .TypeName}}<div>{{.TypeName}}</div>{{end}}
                      <div>{{.EntryOrbID}}</div>
                    </td>
                    <td>{{.Field}}</td>
                    <td><code>{{.IntendedValue}}</code></td>
                    <td><code>{{.OverrideValue}}</code></td>
                    <td>{{.Who}}</td>
                    <td>{{.FirstSeenAt}}</td>
                    <td style="white-space:nowrap;">
                      {{if eq .ResolutionAction "accept"}}
                        <span class="has-text-success has-text-weight-medium" title="Decided by {{.ResolutionActor}} on {{.DecidedAt}}">accepted</span>
                      {{else if eq .ResolutionAction "reject"}}
                        <span class="has-text-danger has-text-weight-medium" title="Decided by {{.ResolutionActor}} on {{.DecidedAt}}">rejected</span>
                      {{else if eq .ResolutionAction "ignore"}}
                        <span class="has-text-warning-dark has-text-weight-medium" title="Decided by {{.ResolutionActor}} on {{.DecidedAt}}">ignored</span>
                      {{else if $.CanResolve}}
                      <div class="buttons has-addons divergence-action-group" data-entry-id="{{.ID}}" data-entry-orbid="{{.EntryOrbID}}" data-entry-field="{{.Field}}" style="margin-bottom:0; flex-wrap:nowrap;">
                        <button
                          type="button"
                          class="button is-small is-success is-outlined divergence-action-btn"
                          data-action="accept"
                          onclick="toggleDivergenceAction(this)"
                          title="Update orbital intent to match the override"
                          style="width:5rem;"
                        >Accept</button>
                        <button
                          type="button"
                          class="button is-small is-warning is-outlined divergence-action-btn"
                          data-action="ignore"
                          onclick="toggleDivergenceAction(this)"
                          title="Acknowledge without effect"
                          style="width:5rem;"
                        >Ignore</button>
                        <button
                          type="button"
                          class="button is-small is-danger is-outlined divergence-action-btn"
                          data-action="reject"
                          onclick="toggleDivergenceAction(this)"
                          title="Reject the override: cloud intent wins, edge resets, cb-controller takes ownership"
                          style="width:5rem;"
                        >Reject</button>
                      </div>
                      {{else}}
                      <span class="has-text-grey">pending</span>
                      {{end}}
                    </td>
                  </tr>
                  {{end}}
                </tbody>
              </table>
            </td>
          </tr>
          {{else}}
          <tr><td colspan="5" class="has-text-grey">No divergence reports.</td></tr>
          {{end}}
        </tbody>
      </table>

      {{if and .CanResolve .Groups}}
      <div class="is-flex is-align-items-center is-justify-content-flex-end mt-4" style="gap:1rem;">
        <span id="divergence-batch-counter" class="has-text-grey is-size-7">No decisions selected.</span>
        <button type="submit" id="divergence-batch-submit" class="button is-primary" disabled>
          <span class="icon is-small"><i class="fa-solid fa-check"></i></span>
          <span>Submit Decisions</span>
        </button>
      </div>
      {{end}}
      </form>
{{end}}

{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if not .IsAuthn}}
        <div class="notification is-warning is-light">
          <a class="js-modal-trigger" data-target="login-modal">Login</a> to view this page.
        </div>
      {{else}}

      {{if not .CanMutate}}{{template "access-required" .}}{{end}}

      <p class="is-size-4 mb-2" data-testid="page-heading">Publish History</p>
      <p class="has-text-grey mb-5" style="font-size: 0.875rem;">
        Record of OCI artifacts orbital has published from subgraph exports. Each row is a signed, versioned snapshot of a data center's configuration. ACR is the source of truth for what currently exists in the registry; this page records orbital's publish events.
      </p>

      {{if .CanMutate}}
      <section class="mb-6" style="max-width: 520px;">
        <div class="field">
          <label class="label">Registry</label>
          <div class="control has-icons-right">
            {{if .OCIConfigured}}
              <input class="input is-small has-background-light has-text-grey-dark" type="text" value="{{.OCIRegistry}}/{{.OCIRepo}}/{datacenter-name}" readonly style="cursor: default;">
              <span class="icon is-small is-right has-text-grey-light"><i class="fas fa-lock"></i></span>
            {{else}}
              <input class="input is-small is-danger" type="text" value="OCI not configured" readonly style="cursor: default;">
              <p class="help is-danger">Set ORBITAL_OCI_REGISTRY and ORBITAL_OCI_SIGNING_KEY_PATH</p>
            {{end}}
          </div>
          {{if .OCIConfigured}}<p class="help has-text-grey-light">Configurable only via environment variable</p>{{end}}
        </div>

        {{if .OCIConfigured}}
        <div class="field mt-4">
          <label class="label">Signing Public Key</label>
          <div class="control">
            <div class="is-flex is-align-items-center" style="gap: 0.5rem;">
              <button id="btn-show-pubkey" class="button is-light is-small js-pubkey-toggle">
                <span class="icon"><i class="fa-solid fa-key"></i></span>
                <span>Show</span>
              </button>
              <button id="btn-copy-pubkey" class="button is-light is-small js-pubkey-copy" style="display:none;">
                <span class="icon"><i class="fas fa-copy"></i></span>
                <span>Copy</span>
              </button>
              <button id="btn-download-pubkey" class="button is-light is-small js-pubkey-download" style="display:none;">
                <span class="icon"><i class="fas fa-download"></i></span>
                <span>Download</span>
              </button>
            </div>
            <pre id="pubkey-display" class="is-family-monospace is-size-7 mt-2" style="display:none;background:var(--bulma-background);padding:0.75rem;white-space:pre-wrap;word-break:break-all;"></pre>
            <div id="pubkey-verify-cmd" style="display:none;" class="mt-3">
              <p class="is-size-7 has-text-grey mb-1">Verify an artifact signature:</p>
              <div class="is-flex is-align-items-center" style="gap:0.5rem;">
                <pre id="pubkey-verify-cmd-text" class="is-family-monospace is-size-7" style="background:var(--bulma-background);padding:0.5rem 0.75rem;margin:0;flex:1;white-space:pre-wrap;word-break:break-all;"></pre>
                <button class="button is-small is-white js-pubkey-verify-cmd-copy" title="Copy command">
                  <span class="icon"><i class="fas fa-copy"></i></span>
                </button>
              </div>
            </div>
          </div>
          <p class="help has-text-grey-light">Distribute to orbs for artifact signature verification</p>
        </div>
        {{end}}
      </section>
      {{end}}

      <div class="mt-4">
        <div class="is-flex is-align-items-center mb-3" style="gap: 0.75rem;">
          <p class="is-size-5">Published Artifacts</p>
          <button class="button is-small is-link js-artifacts-reload" title="Reload">
            <span class="icon"><i class="fa-solid fa-rotate-right"></i></span>
            <span>Reload</span>
          </button>
        </div>
        {{/* Bounded scroll container: even with 100 history rows (the server-side
             cap in OCI.ListArtifacts), the page doesn't grow unbounded.
             Sticky <thead> keeps column headers visible while scrolling inside. */}}
        <div style="overflow:auto; max-height: calc(100vh - 420px); border: 1px solid var(--bulma-border);">
          <table id="artifacts-table" class="table is-striped is-hoverable is-fullwidth is-size-7 mb-0" style="table-layout: fixed;">
            {{/* Column order: identity (Data Center, Tag) → outcome (Status) →
                 when (Published At) → Layers, Signed. Repository and the full
                 Error message are wide end columns you scroll right to reach —
                 a deliberate tradeoff (full detail, no truncation, at the cost
                 of horizontal scroll). Digest moved to the expandable child row.
                 Fixed rem widths push the table wider than the container so the
                 end columns overflow into a scroll. 10 cols = 10 <th> = 10 <td>. */}}
            <colgroup>
              <col style="width: 2.5rem">  {{/* chevron */}}
              <col style="width: 9rem">    {{/* Data Center */}}
              <col style="width: 4.5rem">  {{/* Tag */}}
              <col style="width: 7rem">    {{/* Status */}}
              <col style="width: 11rem">   {{/* Published At */}}
              <col style="width: 13rem">   {{/* Published By */}}
              <col style="width: 6rem">    {{/* Layers */}}
              <col style="width: 7rem">    {{/* Signed */}}
              <col style="width: 22rem">   {{/* Repository */}}
              <col style="width: 26rem">   {{/* Error */}}
            </colgroup>
            <thead style="position: sticky; top: 0; background-color: var(--bulma-scheme-main); z-index: 1; box-shadow: 0 1px 0 var(--bulma-border);">
              <tr>
                <th></th>
                <th>Data Center</th>
                <th>Tag</th>
                <th>Status</th>
                <th>Published At (UTC)</th>
                <th>Published By</th>
                <th>Layers</th>
                <th>Signed</th>
                <th>Repository</th>
                <th>Error</th>
              </tr>
            </thead>
            <tbody id="artifacts-tbody">
              <tr><td colspan="10" class="has-text-grey">No artifacts yet.</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      {{end}}
    </div>
  </main>

  <div id="layers-modal" class="modal">
    <div class="modal-background" onclick="document.getElementById('layers-modal').classList.remove('is-active')"></div>
    <div id="layers-modal-body"></div>
  </div>
{{end}}

{{if .Items}}
<div style="overflow-x:auto">
<table class="table is-striped is-hoverable is-fullwidth is-size-7 mt-2">
  <thead>
    <tr>
      <th>Timestamp</th>
      <th>Actor</th>
      <th>Operations</th>
      <th>Variables</th>
    </tr>
  </thead>
  <tbody>
    {{range .Items}}
    <tr>
      <td style="white-space:nowrap"><span data-timestamp="{{.Timestamp}}">{{.Timestamp}}</span></td>
      <td>{{if .Actor}}{{.Actor}}{{else}}—{{end}}</td>
      <td>{{range .Operations}}<span class="tag is-info is-light is-small">{{.}}</span> {{end}}</td>
      <td style="font-size:0.7rem">{{if eq .EventCategory "management"}}—{{else if .DiffHTML}}{{.DiffHTML}}{{else}}<span style="color:var(--bulma-text-weak)">{{.VarSummary}}</span>{{end}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
</div>
{{if and .OrbIDQueryString (lt .ShownCount .Total)}}
<p class="has-text-grey is-size-7 mt-2 px-1">
  Showing last {{.ShownCount}} of {{.Total}} events.
  <a href="{{.BasePath}}/audit-log?{{.OrbIDQueryString}}">View all in Audit Log &rarr;</a>
</p>
{{end}}
{{else}}
<p class="has-text-grey p-2">No audit events recorded yet.</p>
{{end}}

{{define "publish-modal-progress"}}
{{/* Phases: pending → bundling → pushing → signing → completed/failed.
     The spinner sits on the current step; earlier steps get a check;
     later steps stay greyed out until they begin. */}}
<div
  hx-get="{{.BasePath}}/api/v1/oci/artifacts/{{.ArtifactID}}"
  hx-trigger="every 200ms"
  hx-target="#publish-modal-body"
  hx-swap="innerHTML"
  hx-headers='{"HX-Request":"true"}'
>
  <ul class="is-size-7" style="list-style:none;padding:0;margin:0;line-height:1.8">
    <li>
      {{if eq .Phase "bundling"}}
        <span class="icon has-text-info"><i class="fa-solid fa-spinner fa-spin"></i></span>
        <strong>Bundling (calling {{.BundlerNames}})…</strong>
      {{else if or (eq .Phase "pushing") (eq .Phase "signing") (eq .Phase "completed")}}
        <span class="icon has-text-success"><i class="fa-solid fa-check"></i></span>
        <span class="has-text-grey">Bundling (calling {{.BundlerNames}})</span>
      {{else}}
        <span class="icon has-text-grey-light"><i class="fa-regular fa-circle"></i></span>
        <span class="has-text-grey-light">Bundling (calling {{.BundlerNames}})</span>
      {{end}}
    </li>
    <li>
      {{if eq .Phase "pushing"}}
        <span class="icon has-text-info"><i class="fa-solid fa-spinner fa-spin"></i></span>
        <strong>Pushing to registry…</strong>
      {{else if or (eq .Phase "signing") (eq .Phase "completed")}}
        <span class="icon has-text-success"><i class="fa-solid fa-check"></i></span>
        <span class="has-text-grey">Pushing to registry</span>
      {{else}}
        <span class="icon has-text-grey-light"><i class="fa-regular fa-circle"></i></span>
        <span class="has-text-grey-light">Pushing to registry</span>
      {{end}}
    </li>
    <li>
      {{if eq .Phase "signing"}}
        <span class="icon has-text-info"><i class="fa-solid fa-spinner fa-spin"></i></span>
        <strong>Signing artifact…</strong>
      {{else if eq .Phase "completed"}}
        <span class="icon has-text-success"><i class="fa-solid fa-check"></i></span>
        <span class="has-text-grey">Signing artifact</span>
      {{else}}
        <span class="icon has-text-grey-light"><i class="fa-regular fa-circle"></i></span>
        <span class="has-text-grey-light">Signing artifact</span>
      {{end}}
    </li>
  </ul>
</div>
{{end}}

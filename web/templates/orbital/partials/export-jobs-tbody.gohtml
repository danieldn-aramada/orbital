{{range .Rows}}<tr>
  <td style="font-family:monospace;font-size:0.7rem;">{{.JobID}}</td>
  <td>{{.DataCenter}}</td>
  <td data-testid="export-job-status">
    <span class="tag {{.StatusClass}}">{{.Status}}</span>
    {{if .Published}}<span class="tag is-primary is-light ml-1">published</span>{{end}}
  </td>
  <td>{{.CreatedAt}}</td>
  <td>{{.CreatedBy}}</td>
  <td>{{.CompletedAt}}</td>
  <td style="white-space:nowrap;">
    <div style="display:flex;gap:0.25rem;align-items:center;">
      {{if .CanDownload}}<a data-testid="export-download-btn" class="button is-small is-link is-outlined" onclick="downloadExportJob('{{.JobID}}')"><span class="icon"><i class="fa-solid fa-download"></i></span><span>Download</span></a>{{end}}
      {{if and $.OCIConfigured .CanPublish}}<button class="button is-small is-warning is-outlined" onclick="publishExportJob('{{.JobID}}')"><span class="icon"><i class="fa-solid fa-box-archive"></i></span><span>{{if .Published}}Publish Again{{else}}Publish{{end}}</span></button>{{end}}
      <button class="button is-small is-danger is-outlined" title="Delete" onclick="deleteExportJob('{{.JobID}}')"><span class="icon"><i class="fa-solid fa-trash"></i></span></button>
    </div>
  </td>
</tr>
{{else}}<tr><td colspan="7" class="has-text-grey">No export jobs yet.</td></tr>
{{end}}

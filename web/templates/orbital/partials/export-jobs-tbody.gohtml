{{/* Retained Downloads rows — only completed download-flow jobs with an
     on-disk zip. Publish button removed (atomic flow subsumes it via
     /export?download=false). Delete = artifact-only removal via the new
     DELETE /api/v1/export/jobs/:jobId/artifact endpoint; the job row
     itself stays as audit history. */}}
{{range .Rows}}<tr>
  <td>{{.DataCenter}}</td>
  <td data-testid="export-job-status">
    <span class="tag {{.StatusClass}}">{{.Status}}</span>
  </td>
  <td>{{.CreatedAt}}</td>
  <td>{{.CreatedBy}}</td>
  <td>{{.CompletedAt}}</td>
  <td style="white-space:nowrap;">
    <div style="display:flex;gap:0.25rem;align-items:center;">
      {{if .CanDownload}}<a data-testid="export-download-btn" class="button is-small is-link is-outlined js-export-download" data-export-job-id="{{.JobID}}"><span class="icon"><i class="fa-solid fa-download"></i></span><span>Download</span></a>{{end}}
      <button class="button is-small is-danger is-outlined js-export-artifact-delete" data-export-job-id="{{.JobID}}" title="Delete retained zip (keeps audit row)"><span class="icon"><i class="fa-solid fa-trash"></i></span></button>
    </div>
  </td>
</tr>
{{else}}<tr><td colspan="6" class="has-text-grey">No retained downloads.</td></tr>
{{end}}

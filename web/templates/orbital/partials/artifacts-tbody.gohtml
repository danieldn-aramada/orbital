{{range .}}<tr>
  <td>
    {{/* Chevron toggles the sibling detail row (Digest, plus — for completed
         publishes — the changeset since the previous publish). Shown on every
         row so any publish can be expanded to see its digest. */}}
    <button type="button" class="button is-small is-white js-publish-changes-expand" aria-label="Toggle publish details">
      <span class="icon"><i class="fas fa-chevron-right"></i></span>
    </button>
  </td>
  <td>{{.DatacenterName}}</td>
  <td><span class="tag is-light">{{.Tag}}</span></td>
  <td><span class="tag {{.StatusClass}}">{{.Status}}</span></td>
  <td class="is-nowrap">{{.InitiatedAt}}</td>
  <td class="is-size-7" style="overflow-wrap:anywhere;">{{if .PublishedBy}}{{.PublishedBy}}{{else}}<span class="has-text-grey">—</span>{{end}}</td>
  <td class="is-nowrap">
    {{if .HasLayers}}
      <div class="is-flex is-align-items-center" style="gap:0.25rem;">
        <span class="tag is-light is-small">{{len .LayerRows}}</span>
        <button class="button is-small is-white" title="View layers"
          hx-get="{{.BasePath}}/api/v1/oci/artifacts/{{.ID}}/layers"
          hx-target="#layers-modal-body"
          hx-swap="innerHTML"
          onclick="document.getElementById('layers-modal').classList.add('is-active')">
          <span class="icon"><i class="fas fa-up-right-from-square"></i></span>
        </button>
      </div>
    {{else if .Enriched}}<span class="tag is-info is-light is-small">bundled</span>
    {{else}}—{{end}}
  </td>
  <td>{{if .Signed}}<span class="tag is-success is-light">signed</span>{{else}}<span class="tag is-light">unsigned</span>{{end}}</td>
  <td class="is-family-monospace is-size-7" style="word-break: break-all;">{{.Repository}}</td>
  {{/* Full failure reason lives in its own end column (not conflated into the
       Status badge). Both error fields render here; empty for successful rows. */}}
  <td class="has-text-danger is-size-7" style="overflow-wrap:anywhere;">
    {{if .Error}}<div>{{.Error}}</div>{{end}}
    {{if .BundlerError}}<div>{{.BundlerError}}</div>{{end}}
  </td>
</tr>
{{/* Detail row: hidden until the chevron toggles it (delegated handler in
     orbital.js). Carries the Digest; completed publishes also HTMX-lazily fetch
     audit events since the previous publish
     (see /api/v1/audit-log ?namespace=&since=&until=). */}}
<tr class="js-publish-changes-detail is-hidden">
  <td></td>
  <td colspan="9" style="background: var(--bulma-background);">
    <div class="mb-2 is-flex is-align-items-center" style="gap:0.35rem;">
      <span class="has-text-grey is-size-7">Digest:</span>
      {{if .HasDigest}}
      <span class="is-family-monospace is-size-7">{{.Digest}}</span>
      <button class="button is-small is-white" title="Copy digest" data-copy-value="{{.Digest}}"><span class="icon"><i class="fas fa-copy"></i></span></button>
      {{else}}<span class="is-size-7">—</span>{{end}}
    </div>
    {{if eq .Status "completed"}}
    {{if .HasPrevious}}
    <div class="mb-2">
      <span class="has-text-grey is-size-7">Changes since
        <span class="is-family-monospace">{{.PreviousExportedAtRFC3339}}</span></span>
    </div>
    <div hx-get="{{.BasePath}}/api/v1/audit-log?namespace={{.DatacenterNamespace}}&since={{.PreviousExportedAtRFC3339}}&until={{.ExportedAtRFC3339}}&event_category=data&limit=200"
         hx-trigger="revealed once"
         hx-target="this"
         hx-swap="innerHTML"
         hx-headers='{"HX-Request":"true"}'>
      <p class="has-text-grey is-size-7"><span class="icon is-small"><i class="fas fa-spinner fa-spin"></i></span> Loading changes…</p>
    </div>
    {{else}}
    <p class="has-text-grey is-size-7">No previous publish for <strong>{{.DatacenterName}}</strong> — this is the first successful publish in the visible history.</p>
    {{end}}
    {{end}}
  </td>
</tr>
{{else}}<tr><td colspan="10" class="has-text-grey">No artifacts yet.</td></tr>
{{end}}

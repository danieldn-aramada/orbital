{{/* The version the operator is looking at. Echoed back on confirm as
     ?ifVersion= so a delete cannot land on an entity that moved while
     this dialog was open. */}}
<span id="cfg-delete-version" data-version="{{.Version}}" hidden></span>
<p class="mb-2">This will permanently delete this {{if eq .Type "DataCenter"}}data center{{else if eq .Type "KubernetesCluster"}}Kubernetes cluster{{else}}server{{end}} and all associated records:</p>
<ul class="is-size-7" style="list-style:disc;padding-left:1.25rem">
  {{range .Groups}}<li>{{.Count}} {{.Label}}</li>{{end}}
</ul>
<p class="mt-3 has-text-weight-semibold is-size-7">Total: {{.TotalCount}} nodes</p>
{{if .Preserved}}
<div class="mt-3">
  <p class="mb-1 has-text-grey is-size-7">Will <strong>not</strong> be deleted:</p>
  <ul class="is-size-7" style="list-style:disc;padding-left:1.25rem">
    {{range .Preserved}}<li>{{.Label}}: {{range $i, $v := .Items}}{{if $i}}, {{end}}{{$v}}{{end}}</li>{{end}}
  </ul>
</div>
{{end}}

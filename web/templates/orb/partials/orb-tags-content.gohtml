<div style="overflow-x: auto">
  <table id="orb-tags-table" class="table is-striped is-hoverable is-fullwidth is-size-7">
    <thead>
      <tr>
        <th>Tag</th>
        <th>Signature</th>
        <th>Digest</th>
        <th>Size</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="orb-tags-tbody">
      {{range .Rows}}<tr data-tag="{{.Name}}">
        <td><strong>{{.Name}}</strong></td>
        <td>{{if .Verified}}<span class="tag is-success is-light"><i class="fa-solid fa-shield-check"></i>&nbsp;verified</span>{{else}}<span class="tag is-light has-text-grey">unverified</span>{{end}}</td>
        <td>
          {{if .HasDigest}}<div style="display:flex;align-items:center;gap:0.25rem;">
            <span class="is-family-monospace is-size-7">{{.Digest}}</span>
            <button class="button is-small is-white" title="Copy digest" data-copy-value="{{.Digest}}"><span class="icon"><i class="fas fa-copy"></i></span></button>
          </div>{{else}}—{{end}}
        </td>
        <td class="has-text-grey is-size-7">{{.Size}}</td>
        <td><button class="button is-info is-small js-orb-import" data-tag="{{.Name}}"><span class="icon"><i class="fa-solid fa-download"></i></span><span>Import</span></button></td>
      </tr>
      {{else}}<tr><td colspan="5" class="has-text-grey">No versions available.</td></tr>
      {{end}}
    </tbody>
  </table>
</div>
{{if gt .Total 0}}
<nav class="is-flex is-align-items-center is-justify-content-flex-end mt-3" style="gap: 1rem;" role="navigation" aria-label="pagination">
  <span class="has-text-grey is-size-7">Showing {{.FirstRow}}–{{.LastRow}} of {{.Total}}</span>
  <div class="buttons has-addons is-small mb-0">
    <button type="button" class="button is-small"
            {{if .HasPrev}}hx-get="{{.BasePath}}/api/v1/import/tags?limit={{.Limit}}&offset={{.PrevOffset}}"
            hx-target="#orb-tags-content"
            hx-swap="innerHTML"{{else}}disabled{{end}}>
      <span class="icon is-small"><i class="fas fa-chevron-left"></i></span>
      <span>Previous</span>
    </button>
    <button type="button" class="button is-small"
            {{if .HasNext}}hx-get="{{.BasePath}}/api/v1/import/tags?limit={{.Limit}}&offset={{.NextOffset}}"
            hx-target="#orb-tags-content"
            hx-swap="innerHTML"{{else}}disabled{{end}}>
      <span>Next</span>
      <span class="icon is-small"><i class="fas fa-chevron-right"></i></span>
    </button>
  </div>
</nav>
{{end}}

{{define "layers-modal"}}
<div class="modal-card" style="width:760px;max-width:95vw;">
  <header class="modal-card-head">
    <p class="modal-card-title is-size-6">Layers — {{.Tag}}</p>
    <button class="delete" aria-label="close" onclick="document.getElementById('layers-modal').classList.remove('is-active')"></button>
  </header>
  <section class="modal-card-body">
    {{if .Layers}}
    {{/* Columns mirror orbital's signed-artifacts layers-modal:
         Producer | Media Type | Size | Digest. orbital-producer pill is
         light blue (is-info is-light); bundler-named producers stay neutral. */}}
    <table class="table is-fullwidth is-striped is-size-7">
      <thead>
        <tr>
          <th>Producer</th>
          <th>Media Type</th>
          <th class="is-nowrap">Size</th>
          <th class="is-nowrap">Dispatch</th>
          <th>Digest</th>
        </tr>
      </thead>
      <tbody>
        {{range .Layers}}
        <tr>
          <td>
            {{if .Producer}}
              <span class="tag is-light{{if eq .Producer "orbital"}} is-info{{end}}">{{.Producer}}</span>
            {{else}}
              <span class="has-text-grey is-size-7">(unannotated)</span>
            {{end}}
          </td>
          <td class="is-family-monospace">{{.MediaType}}</td>
          <td class="is-nowrap">{{.SizeDisplay}}</td>
          <td class="is-nowrap">
            {{if eq .Role "graph"}}
              <span class="has-text-grey">—</span>
            {{else if .Dispatch}}
              {{if eq .Role "dispatched"}}
                <span class="tag is-success is-light" title="{{.Dispatch.ConsumerName}} {{.Dispatch.URL}}">{{.Dispatch.StatusCode}}{{if .Dispatch.ConsumerName}} · {{.Dispatch.ConsumerName}}{{end}}</span>
              {{else}}
                <span class="tag is-danger is-light" title="{{.Dispatch.Error}}">{{if .Dispatch.StatusCode}}{{.Dispatch.StatusCode}}{{else}}error{{end}}</span>
              {{end}}
            {{else}}
              <span class="has-text-grey">—</span>
            {{end}}
          </td>
          <td class="is-family-monospace is-size-7" style="word-break:break-all;">{{if .Digest}}{{.Digest}}{{else}}—{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}
    <p class="has-text-grey">No layer records for this import.</p>
    {{end}}
  </section>
  <footer class="modal-card-foot">
    <button class="button is-small" onclick="document.getElementById('layers-modal').classList.remove('is-active')">Close</button>
  </footer>
</div>
{{end}}

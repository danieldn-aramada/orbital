{{define "page"}}
<main class="app-main-grid">
  <div class="app-menu">
    {{template "menu.gohtml" .}}
  </div>
  <div class="app-main p-5">

    <p class="is-size-4 mb-4">Import History</p>

    {{if .History}}
    <table id="import-history-table" class="table is-striped is-hoverable" style="table-layout:auto;width:100%;--bulma-table-cell-padding:0.5em 1.5em">
      <thead>
        <tr>
          <th style="white-space:nowrap;padding-left:0">Tag</th>
          <th style="white-space:nowrap">Status</th>
          <th style="white-space:nowrap">Signature</th>
          <th style="white-space:nowrap">Layers</th>
          <th style="white-space:nowrap">Imported At</th>
          <th style="white-space:nowrap">DC Orb ID</th>
          <th style="width:100%">Error</th>
        </tr>
      </thead>
      <tbody>
        {{range .History}}
        <tr>
          <td style="white-space:nowrap;padding-left:0"><code>{{.Tag}}</code></td>
          <td style="white-space:nowrap">
            {{if eq .Status "done"}}
            <span class="tag is-success is-light">done</span>
            {{else if eq .Status "failed"}}
            <span class="tag is-danger is-light">failed</span>
            {{else if eq .Status "running"}}
            <span class="tag is-warning is-light">running</span>
            {{else}}
            <span class="tag is-light">{{.Status}}</span>
            {{end}}
          </td>
          <td style="white-space:nowrap">
            {{if eq .Verification "verified"}}
            <span class="tag is-success is-light"><span class="icon is-small"><i class="fa-solid fa-circle-check"></i></span><span>verified</span></span>
            {{else if eq .Verification "unverified"}}
            <span class="tag is-warning is-light"><span class="icon is-small"><i class="fa-solid fa-circle-xmark"></i></span><span>unverified</span></span>
            {{else}}
            <span class="tag is-light has-text-grey">—</span>
            {{end}}
          </td>
          <td style="white-space:nowrap">
            {{if .Layers}}
              {{$graph := 0}}{{$dispatched := 0}}{{$failed := 0}}
              {{range .Layers}}
                {{if eq .Role "graph"}}{{$graph = add $graph 1}}{{end}}
                {{if ne .Role "graph"}}{{$dispatched = add $dispatched 1}}{{end}}
                {{if eq .Role "dispatched"}}
                  {{if not (and .Dispatch (gt .Dispatch.StatusCode 0) (lt .Dispatch.StatusCode 300))}}{{$failed = add $failed 1}}{{end}}
                {{end}}
              {{end}}
              <div class="is-flex is-align-items-center" style="gap:0.25rem;">
                <span class="tag is-light is-small">{{$graph}} graph</span>
                {{if gt $dispatched 0}}<span class="tag is-info is-light is-small">{{$dispatched}} dispatched</span>{{end}}
                {{if gt $failed 0}}<span class="tag is-danger is-light is-small">{{$failed}} failed</span>{{end}}
                <button class="button is-small is-white" title="View layers"
                  hx-get="/api/v1/import/history/{{.Tag}}/layers"
                  hx-target="#layers-modal-body"
                  hx-swap="innerHTML"
                  onclick="document.getElementById('layers-modal').classList.add('is-active')">
                  <span class="icon"><i class="fas fa-up-right-from-square"></i></span>
                </button>
              </div>
            {{else}}
            —
            {{end}}
          </td>
          <td style="white-space:nowrap"><span class="is-size-7">{{if not .ImportedAt.IsZero}}<span data-timestamp="{{.ImportedAt.Format "2006-01-02T15:04:05Z07:00"}}">{{.ImportedAt.Format "2006-01-02 15:04"}}</span>{{else}}—{{end}}</span></td>
          <td style="white-space:nowrap"><span class="is-size-7">{{if .DCOrbID}}{{.DCOrbID}}{{else}}—{{end}}</span></td>
          <td>
            {{if or .Error .DispatchErrors}}
              {{if .Error}}<span class="is-size-7 has-text-danger" style="display:block">{{.Error}}</span>{{end}}
              {{range .DispatchErrors}}<span class="is-size-7 has-text-danger" style="display:block">{{.}}</span>{{end}}
            {{else}}—{{end}}
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}
    <article class="box">
      <p class="has-text-grey">No import history yet.</p>
    </article>
    {{end}}

  </div>
</main>

<div id="layers-modal" class="modal">
  <div class="modal-background" onclick="document.getElementById('layers-modal').classList.remove('is-active')"></div>
  <div id="layers-modal-body"></div>
</div>
{{end}}

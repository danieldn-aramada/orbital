{{define "page"}}
<main class="app-main-grid">
  <div class="app-menu">
    {{template "menu.gohtml" .}}
  </div>
  <div class="app-main p-5">

    <p class="is-size-4 mb-2">Divergence Report</p>
    <p class="has-text-grey mb-4" style="font-size: 0.875rem;">
      Reports arrive from configbundle-controller on its reporter tick (configurable interval). Click <strong>Refresh</strong> to pull the latest snapshot.
    </p>

    <div class="field mb-4">
      <div class="control is-flex is-align-items-center" style="gap: 0.75rem;">
        <button id="btn-refresh-divergence" class="button is-info is-small" onclick="refreshOrbDivergence()">
          <span class="icon"><i class="fa-solid fa-rotate"></i></span>
          <span>Refresh</span>
        </button>
        {{if .S3Configured}}
          <button class="button is-primary is-small" id="publish-btn" onclick="publishDivergence()">
            <span class="icon"><i class="fa-solid fa-upload"></i></span>
            <span>Publish to S3</span>
          </button>
          <button id="btn-test-divergence-connection" type="button" class="button is-light is-small"
                  hx-post="{{.BasePath}}/api/v1/divergence/test-connection"
                  hx-target="#divergence-connection-result"
                  hx-swap="innerHTML">
            <span class="icon"><i class="fa-solid fa-plug"></i></span>
            <span>Test Connection</span>
          </button>
          <span id="divergence-connection-result" class="is-size-7"></span>
        {{else}}
          <span class="tag is-warning is-light">S3 not configured — publish disabled</span>
        {{end}}
      </div>
    </div>

    {{/* Inline status slot — populated by publishDivergence() in orb.js after Publish. */}}
    <div id="publish-status" class="notification is-size-7" style="display:none;"></div>

    {{/* Refresh swaps this div's inner HTML with the same {{define "divergence-content"}}
         fragment the server returns when called with HX-Request: true. */}}
    <div id="divergence-content">
      {{template "divergence-content" .}}
    </div>

  </div>
</main>
{{end}}

{{define "divergence-content"}}
  {{if .LastPublish}}
  <p class="has-text-grey is-size-7 mb-4">
    Last published: {{.LastPublish.PublishedAt.Format "2006-01-02 15:04:05 UTC"}}
    &nbsp;·&nbsp; <code class="is-size-7">{{.LastPublish.S3Key}}</code>
  </p>
  {{end}}

  {{if not .Entries}}
  <div class="notification is-light">
    <span class="icon-text">
      <span class="icon has-text-success"><i class="fa-solid fa-circle-check"></i></span>
      <span>No divergence reports received. All fields match orbital intent.</span>
    </span>
  </div>
  {{else}}
  <p class="has-text-grey is-size-7 mb-3">{{len .Entries}} override{{if gt (len .Entries) 1}}s{{end}} pending</p>
  <div class="table-container">
    <table class="table is-fullwidth is-hoverable is-size-7" id="divergence-table">
      <thead>
        <tr>
          <th>Orb ID</th>
          <th>Field</th>
          <th>Intended</th>
          <th>Override</th>
          <th>Who</th>
          <th>When</th>
        </tr>
      </thead>
      <tbody>
        {{range .Entries}}
        <tr>
          <td>{{.OrbID}}</td>
          <td>{{.Field}}</td>
          <td><code>{{.IntendedValue}}</code></td>
          <td><code>{{.OverrideValue}}</code></td>
          <td>{{.Who}}</td>
          <td>{{.When}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{end}}
{{end}}

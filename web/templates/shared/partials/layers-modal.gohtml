{{/*
layers-modal.gohtml — the OCI layers table, shared by orbital and orb.

Render context is component.LayersModal. The Dispatch column is orb-only
(ShowDispatch); everything else is identical, which is why this stopped being
two files on 2026-09-23.

Position is the OCI manifest index (0 = base = data.json.gz per the OCI Image
Spec). Rows are reverse-ordered by the handler so the topmost layer appears at
the top of the table (stack diagram). Cross-references the courier zip filename
`layer-<Position>-...`. Producer comes from the OCI annotation
com.armada.orbital.producer, declared by orbital at push time; it falls back to
"(unannotated)" for artifacts published before producer attribution shipped.
*/}}
{{define "layers-modal"}}
<div class="modal-card" style="width:760px;max-width:95vw;">
  <header class="modal-card-head">
    <p class="modal-card-title is-size-6">Layers — {{.Tag}}</p>
    <button class="delete" aria-label="close" data-modal-close></button>
  </header>
  <section class="modal-card-body">
    {{if .Rows}}
    <div class="table-container">
      <table class="table is-striped is-hoverable is-fullwidth is-size-7">
        <thead>
          <tr>
            <th class="is-nowrap has-text-right"><span class="tooltip" data-text="OCI manifest position (0 = base)">#</span></th>
            <th>Producer</th>
            <th>Media Type</th>
            <th class="is-nowrap">Size</th>
            {{if $.ShowDispatch}}<th class="is-nowrap">Dispatch</th>{{end}}
            <th>Digest</th>
          </tr>
        </thead>
        <tbody>
          {{range .Rows}}
          <tr>
            <td class="is-nowrap has-text-right has-text-grey">{{.Position}}</td>
            <td>
              {{if .Producer}}
                <span class="tag is-light{{if eq .Producer "orbital"}} is-info{{end}}">{{.Producer}}</span>
              {{else if .IsOrbitalNative}}
                <span class="tag is-info is-light">orbital</span>
              {{else}}
                <span class="has-text-grey">(unannotated)</span>
              {{end}}
            </td>
            <td class="is-family-monospace">{{.MediaType}}</td>
            <td class="is-nowrap">{{.SizeDisplay}}</td>
            {{if $.ShowDispatch}}
            <td>
              {{if eq .Role "graph"}}
                <span class="has-text-grey">—</span>
              {{else if .Dispatch}}
                {{if eq .Role "dispatched"}}
                  <span class="tag is-success is-light is-nowrap tooltip" data-text="{{.Dispatch.ConsumerName}} {{.Dispatch.URL}}">{{.Dispatch.StatusCode}}{{if .Dispatch.ConsumerName}} · {{.Dispatch.ConsumerName}}{{end}}</span>
                {{else}}
                  <span class="tag is-danger is-light is-nowrap">{{if .Dispatch.StatusCode}}{{.Dispatch.StatusCode}}{{else}}error{{end}}{{if .Dispatch.ConsumerName}} · {{.Dispatch.ConsumerName}}{{end}}</span>
                  {{if .Dispatch.Error}}<div class="has-text-danger mt-1" style="word-break:break-word; white-space:normal;">{{.Dispatch.Error}}</div>{{end}}
                {{end}}
              {{else}}
                <span class="has-text-grey">—</span>
              {{end}}
            </td>
            {{end}}
            <td class="is-family-monospace" style="word-break:break-all;">{{if .Digest}}{{.Digest}}{{else}}—{{end}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{else}}
    <p class="has-text-grey">{{.EmptyMessage}}</p>
    {{end}}
  </section>
  <footer class="modal-card-foot">
    <button class="button is-small" data-modal-close>Close</button>
  </footer>
</div>
{{end}}

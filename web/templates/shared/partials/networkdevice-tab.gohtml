<div class="fixed-grid has-3-cols mb-0">

  <div class="columns m-0">
    <div class="column pt-0 pl-0">
      {{if .Actions.Reload}}
      <button class="button is-rounded is-small is-link mt-1 js-network-device-reload"
        data-network-device-id="{{.OrbID}}">
        <span class="icon"><i class="fa-solid fa-refresh"></i></span>
        <span>Reload</span>
      </button>
      {{end}}
      {{if .Actions.Edit}}
      <button class="button is-rounded is-small is-link mt-1" data-network-device-edit-id="{{.DomID}}">
        <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
        <span>Edit</span>
      </button>
      {{end}}
      {{if .Actions.Delete}}
      <button class="button is-rounded is-small is-danger mt-1"
        data-cfg-delete-id="{{.OrbID}}"
        data-cfg-delete-type="NetworkDevice"
        data-cfg-delete-name="{{.Name}}">
        <span class="icon"><i class="fa-solid fa-trash"></i></span>
        <span>Delete</span>
      </button>
      {{end}}
    </div>
  </div>

  <div class="grid">
    <div class="cell is-col-span-2 is-row-span-1">
      <article class="box">
        <p class="is-size-4 pb-4">Network Device Summary</p>
        <div style="overflow-x: auto">
        <table class="table is-fullwidth">
          <tbody>
            <tr><td style="white-space:nowrap;width:1%">Data Center</td><td>{{if .DataCenterName}}{{.DataCenterName}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Name</td><td>{{if .Name}}{{.Name}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Manufacturer</td><td>{{if .Manufacturer}}{{.Manufacturer}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Model</td><td>{{if .Model}}{{.Model}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Platform</td><td>{{if .Platform}}{{.Platform}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Serial</td><td>{{if .Serial}}{{.Serial}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">MAC Address</td><td>{{if .MacAddress}}{{.MacAddress}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Role</td><td>{{if .Role}}{{.Role}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Rack</td><td>{{if .RackName}}{{.RackName}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Rack Position</td><td>{{if .RackPosition}}{{.RackPosition}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Face</td><td>{{if .Face}}{{.Face}}{{else}}—{{end}}</td></tr>
            {{if .VcPriority}}
            <tr><td style="white-space:nowrap">VC Position</td><td>{{.VcPosition}}</td></tr>
            <tr><td style="white-space:nowrap">VC Priority</td><td>{{.VcPriority}}</td></tr>
            {{end}}
            {{if .VirtualChassisName}}<tr><td style="white-space:nowrap">VC Master</td><td>{{.VirtualChassisName}}</td></tr>{{end}}
          </tbody>
        </table>
        </div>
      </article>
    </div>

    <div class="cell is-row-span-1">
      <article class="box" style="height:100%">
        <p class="is-size-4 mb-4">Metadata</p>
        <div style="overflow-x: auto">
        <table class="table mb-0">
          <tbody>
            <tr><td style="white-space:nowrap;width:1%">Namespace</td><td>{{if .Namespace}}{{.Namespace}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Orb ID</td><td>{{if .OrbID}}{{.OrbID}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Created By</td><td>{{if .CreatedBy}}{{.CreatedBy}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Created At</td><td>{{if .CreatedAt}}<span data-timestamp="{{.CreatedAt}}">{{.CreatedAt}}</span>{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Last Updated</td><td>{{if .UpdatedAt}}<span data-timestamp="{{.UpdatedAt}}">{{.UpdatedAt}}</span>{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Last Updated By</td><td>{{if .UpdatedBy}}{{.UpdatedBy}}{{else}}—{{end}}</td></tr>
          </tbody>
        </table>
        </div>
      </article>
    </div>

    <div class="cell is-col-span-3 is-fullheight">
      <article class="box pb-2">
        <p class="is-size-4 pb-4">Details</p>
        <div class="tabs is-boxed" id="network-device-detail-tabs-{{.DomID}}">
          <ul>
            <li class="is-active" data-panel="network-device-panel-connections-{{.DomID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-diagram-project"></i></span><span>Connections{{if .Connections}} ({{len .Connections}}){{end}}</span></a>
            </li>
            <li data-panel="network-device-panel-servers-{{.DomID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-server"></i></span><span>Servers</span></a>
            </li>
            {{template "audit-tab-li" .}}
          </ul>
        </div>

        <div style="min-height: 300px">
        {{/* Connections — the interface-level wiring: every cabled port, server or device on the remote end */}}
        <div id="network-device-panel-connections-{{.DomID}}">
          {{if .Connections}}
          <div style="overflow-x:auto">
          <table class="table is-striped is-hoverable is-size-7 mt-2">
            <colgroup>
              <col style="width:36%"><col style="width:20%"><col style="width:22%"><col style="width:22%">
            </colgroup>
            <thead>
              <tr><th>Connected To</th><th>Type</th><th>Local Port</th><th>Remote Port</th></tr>
            </thead>
            <tbody>
              {{range .Connections}}
              {{if eq .RemoteType "server"}}
              <tr data-server-orb-id="{{.RemoteOrbID}}" data-display-name="{{.RemoteName}}" style="cursor:pointer" title="Double-click to open server">
                <td>{{.RemoteName}}</td>
                <td><span class="tag is-light">Server</span></td>
                <td>{{if .LocalPort}}{{.LocalPort}}{{else}}—{{end}}</td>
                <td>{{if .RemotePort}}{{.RemotePort}}{{else}}—{{end}}</td>
              </tr>
              {{else}}
              <tr>
                <td>{{.RemoteName}}</td>
                <td><span class="tag is-info is-light">NetworkDevice</span></td>
                <td>{{if .LocalPort}}{{.LocalPort}}{{else}}—{{end}}</td>
                <td>{{if .RemotePort}}{{.RemotePort}}{{else}}—{{end}}</td>
              </tr>
              {{end}}
              {{end}}
            </tbody>
          </table>
          </div>
          {{else}}
          <p class="is-size-7 has-text-grey p-2">No connections on this device.</p>
          {{end}}
        </div>

        {{/* Servers — the blast-radius rollup: distinct servers with cluster/role */}}
        <div id="network-device-panel-servers-{{.DomID}}" style="display:none">
          {{if .ConnectedServers}}
          <div style="overflow-x:auto">
          <table class="table is-striped is-hoverable is-size-7 mt-2">
            <colgroup>
              <col style="width:26%"><col style="width:22%"><col style="width:20%"><col style="width:16%"><col style="width:16%">
            </colgroup>
            <thead>
              <tr><th>Server</th><th>Cluster</th><th>Node Role</th><th>Server Port</th><th>Device Port</th></tr>
            </thead>
            <tbody>
              {{range .ConnectedServers}}
              <tr data-server-orb-id="{{.ServerOrbID}}" data-display-name="{{.ServerName}}" style="cursor:pointer" title="Double-click to open server">
                <td>{{if .ServerName}}{{.ServerName}}{{else}}—{{end}}</td>
                <td>{{if .ClusterName}}{{.ClusterName}}{{else}}—{{end}}</td>
                <td>{{if .NodeRole}}{{.NodeRole}}{{if .Gpu}} · GPU{{end}}{{else if .Gpu}}GPU{{else}}—{{end}}</td>
                <td>{{if .PortName}}{{.PortName}}{{else}}—{{end}}</td>
                <td>{{if .RemotePort}}{{.RemotePort}}{{else}}—{{end}}</td>
              </tr>
              {{end}}
            </tbody>
          </table>
          </div>
          {{else}}
          <p class="is-size-7 has-text-grey p-2">No servers connected to this device.</p>
          {{end}}
        </div>

        {{template "audit-tab-placeholder" .}}
        </div>

      </article>
    </div>
  </div>

</div>

{{if .Actions.Edit}}{{template "edit-modal-networkdevice.gohtml" .}}{{end}}

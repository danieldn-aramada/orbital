<div class="fixed-grid has-3-cols mb-0">

  <div class="columns m-0">
    <div class="column pt-0 pl-0">
      {{if .Actions.Reload}}
      <button class="button is-rounded is-small is-link mt-1 js-cluster-reload"
        data-cluster-id="{{.OrbID}}">
        <span class="icon"><i class="fa-solid fa-refresh"></i></span>
        <span>Reload</span>
      </button>
      {{end}}
      {{if .Actions.Edit}}
      <button class="button is-rounded is-small is-link mt-1" data-cluster-edit-id="{{.DomID}}">
        <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
        <span>Edit</span>
      </button>
      {{end}}
      {{if .Actions.Delete}}
      <button class="button is-rounded is-small is-danger mt-1"
        data-cfg-delete-id="{{.OrbID}}"
        data-cfg-delete-type="KubernetesCluster"
        data-cfg-delete-name="{{.Name}}">
        <span class="icon"><i class="fa-solid fa-trash"></i></span>
        <span>Delete</span>
      </button>
      {{end}}
    </div>
  </div>


  <div class="grid">
    <div class="cell is-col-span-2 is-row-span-1">
      <article class="box">
        <p class="is-size-4 pb-4">Cluster Summary</p>
        <div style="overflow-x: auto">
        <table class="table is-fullwidth">
          <tbody>
            <tr><td style="white-space:nowrap;width:1%">Name</td><td>{{.Name}}</td></tr>
            <tr><td style="white-space:nowrap">Data Center</td><td>{{if .DataCenterName}}{{.DataCenterName}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Provider</td><td>{{.Provider}}</td></tr>
            {{if eq .Typename "EksaKubernetesCluster"}}
            <tr><td style="white-space:nowrap">Cluster Type</td><td>{{if .ClusterType}}{{.ClusterType}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Tinkerbell IP</td><td>{{if .TinkerbellIP}}{{.TinkerbellIP}}{{else}}—{{end}}</td></tr>
            {{if .ManagementCluster}}
            <tr>
              <td style="white-space:nowrap">Management Cluster</td>
              <td>
                <a class="js-cluster-link" data-cluster-orb-id="{{.ManagementCluster.OrbID}}" data-display-name="{{.ManagementCluster.Name}}" style="cursor:pointer">{{.ManagementCluster.Name}}</a>
              </td>
            </tr>
            {{end}}
            {{end}}
            <tr><td style="white-space:nowrap">K8s Version</td><td>{{if .KubernetesVersion}}{{.KubernetesVersion}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Control Plane Endpoint</td><td>{{if .ControlPlaneEndpoint}}{{.ControlPlaneEndpoint}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">CNI</td><td>{{if .CNI}}{{.CNI}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Environment</td><td>{{if .Environment}}{{.Environment}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Nodes</td><td>{{len .Nodes}}</td></tr>
          </tbody>
        </table>
        </div>
      </article>
    </div>

    <div class="cell is-row-span-1">
      <article class="box" style="height:100%">
        <p class="is-size-4 mb-4">Metadata</p>
        <div style="overflow-x: auto">
        <table class="table mb-0">
          <tbody>
            <tr><td style="white-space:nowrap;width:1%">Namespace</td><td>{{if .Namespace}}{{.Namespace}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Orb ID</td><td>{{if .OrbID}}{{.OrbID}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Created By</td><td>{{if .CreatedBy}}{{.CreatedBy}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Created At</td><td>{{if .CreatedAt}}<span data-timestamp="{{.CreatedAt}}">{{.CreatedAt}}</span>{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Last Updated</td><td>{{if .UpdatedAt}}<span data-timestamp="{{.UpdatedAt}}">{{.UpdatedAt}}</span>{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Last Updated By</td><td>{{if .UpdatedBy}}{{.UpdatedBy}}{{else}}—{{end}}</td></tr>
          </tbody>
        </table>
        </div>
      </article>
    </div>

    <div class="cell is-col-span-3 is-fullheight">
      <article class="box pb-2">
        <p class="is-size-4 pb-4">Details</p>
        <div class="tabs is-boxed" id="cluster-detail-tabs-{{.DomID}}">
          <ul>
            <li class="is-active" data-panel="cluster-panel-nodes-{{.DomID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-server"></i></span><span>Nodes</span></a>
            </li>
            <li data-panel="cluster-panel-backups-{{.DomID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-floppy-disk"></i></span><span>Backups</span></a>
            </li>
            {{if not .ManagementCluster}}
            <li data-panel="cluster-panel-workloads-{{.DomID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-sitemap"></i></span><span>Workload Clusters ({{len .WorkloadClusters}})</span></a>
            </li>
            {{end}}
            {{template "audit-tab-li" .}}
          </ul>
        </div>

        <div style="min-height: 300px">
        <div id="cluster-panel-nodes-{{.DomID}}">
          {{if .Nodes}}
          <div style="overflow-x:auto">
          <table class="table is-striped is-hoverable is-size-7 mt-2">
            <colgroup>
              <col style="width:40%">
              <col style="width:20%">
              <col style="width:40%">
            </colgroup>
            <thead>
              <tr>
                <th>Name</th>
                <th>Role</th>
                <th>Server</th>
              </tr>
            </thead>
            <tbody>
              {{range .Nodes}}
              <tr data-server-orb-id="{{.ServerOrbID}}" data-display-name="{{.ServerName}}" style="cursor:pointer" title="Double-click to open server">
                <td>{{if .Name}}{{.Name}}{{else}}—{{end}}</td>
                <td>{{if .Role}}{{.Role}}{{else}}—{{end}}</td>
                <td>{{if .ServerName}}{{.ServerName}}{{else}}—{{end}}</td>
              </tr>
              {{end}}
            </tbody>
          </table>
          </div>
          {{else}}
          <p class="is-size-7 has-text-grey p-2">No nodes registered yet.</p>
          {{end}}
        </div>

        <div id="cluster-panel-backups-{{.DomID}}" style="display:none">
          {{/*
            Backups follow the orbital convention for parent ConfigItems with
            owned children: this tab is READ-ONLY display. To change anything,
            click the Edit button at the top of the page — the JSON editor
            includes the backup tree as a nested object. Mirrors Server →
            IdracSettings. See docs/reference/UI.md "Edit pattern".
          */}}
          <div style="overflow-x:auto">
          <table class="table is-striped is-hoverable is-size-7 mt-2">
            <colgroup>
              <col style="width:18%">
              <col style="width:12%">
              <col style="width:24%">
              <col style="width:46%">
            </colgroup>
            <thead>
              <tr>
                <th>Kind</th>
                <th>Enabled</th>
                <th>Schedule</th>
                <th>Location</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>etcd</td>
                {{if and .Backup .Backup.Etcd}}
                <td>{{if .Backup.Etcd.Enabled}}<span class="has-text-success">✓</span>{{else}}<span class="has-text-danger">✗</span>{{end}}</td>
                <td><code>{{if .Backup.Etcd.Schedule}}{{.Backup.Etcd.Schedule}}{{else}}—{{end}}</code></td>
                <td><code>{{if .Backup.Etcd.Location}}{{.Backup.Etcd.Location}}{{else}}—{{end}}</code></td>
                {{else}}
                <td colspan="3"><span class="has-text-grey">Not configured</span></td>
                {{end}}
              </tr>
              <tr>
                <td>velero</td>
                {{if and .Backup .Backup.Velero}}
                <td>{{if .Backup.Velero.Enabled}}<span class="has-text-success">✓</span>{{else}}<span class="has-text-danger">✗</span>{{end}}</td>
                <td><code>{{if .Backup.Velero.Schedule}}{{.Backup.Velero.Schedule}}{{else}}—{{end}}</code></td>
                <td><code>{{if .Backup.Velero.Location}}{{.Backup.Velero.Location}}{{else}}—{{end}}</code></td>
                {{else}}
                <td colspan="3"><span class="has-text-grey">Not configured</span></td>
                {{end}}
              </tr>
              <tr>
                <td>s3-sync</td>
                {{if and .Backup .Backup.S3Sync}}
                <td>{{if .Backup.S3Sync.Enabled}}<span class="has-text-success">✓</span>{{else}}<span class="has-text-danger">✗</span>{{end}}</td>
                <td colspan="2"><span class="has-text-grey">—</span></td>
                {{else}}
                <td colspan="3"><span class="has-text-grey">Not configured</span></td>
                {{end}}
              </tr>
            </tbody>
          </table>
          </div>
        </div>

        {{if not .ManagementCluster}}
        <div id="cluster-panel-workloads-{{.DomID}}" style="display:none">
          {{if .WorkloadClusters}}
          <div style="overflow-x:auto">
          <table class="table is-striped is-hoverable is-size-7 mt-2">
            <colgroup>
              <col style="width:30%">
              <col style="width:20%">
              <col style="width:25%">
              <col style="width:25%">
            </colgroup>
            <thead>
              <tr>
                <th>Name</th>
                <th>Environment</th>
                <th>K8s Version</th>
                <th>Nodes</th>
              </tr>
            </thead>
            <tbody>
              {{range .WorkloadClusters}}
              <tr data-cluster-orb-id="{{.OrbID}}" data-display-name="{{.Name}}" style="cursor:pointer" title="Double-click to open cluster">
                <td>{{.Name}}</td>
                <td>{{if .Environment}}{{.Environment}}{{else}}—{{end}}</td>
                <td>{{if .KubernetesVersion}}{{.KubernetesVersion}}{{else}}—{{end}}</td>
                <td>{{.NodeCount}}</td>
              </tr>
              {{end}}
            </tbody>
          </table>
          </div>
          {{else}}
          <p class="is-size-7 has-text-grey p-2">No workload clusters.</p>
          {{end}}
        </div>
        {{end}}

        {{template "audit-tab-placeholder" .}}
        </div>

      </article>
    </div>
  </div>

</div>

{{if .Actions.Edit}}{{template "edit-modal-cluster.gohtml" .}}{{end}}

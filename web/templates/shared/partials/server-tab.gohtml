<div class="fixed-grid has-3-cols mb-0">

  <div class="columns m-0">
    <div class="column pt-0 pl-0">
      {{if .ShowDCBack}}
      <button class="button is-rounded is-small is-warning mt-1"
        hx-get="{{.BasePath}}/datacenters/{{.DataCenterOrbID}}"
        hx-target="#tab-content-{{.DataCenterDomID}}"
        hx-swap="innerHTML">
        <span class="icon"><i class="fa-solid fa-arrow-left"></i></span>
        <span>{{.DataCenterName}}</span>
      </button>
      {{end}}
      {{if .Actions.Reload}}
      <button class="button is-rounded is-small is-link mt-1 js-srv-reload"
        data-srv-url="/servers/{{.OrbID}}{{if .ShowDCBack}}?dcCtx=1{{end}}"
        data-srv-target="{{if .ShowDCBack}}tab-content-{{.DataCenterDomID}}{{else}}tab-content-srv-{{.DomID}}{{end}}">
        <span class="icon"><i class="fa-solid fa-refresh"></i></span>
        <span>Reload</span>
      </button>
      {{end}}
      {{if .Actions.Edit}}
      <button class="button is-rounded is-small is-link mt-1" data-srv-edit-id="{{.DomID}}">
        <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
        <span>Edit</span>
      </button>
      {{end}}
      {{if .Actions.Delete}}
      <button class="button is-rounded is-small is-danger mt-1"
        data-cfg-delete-id="{{.OrbID}}"
        data-cfg-delete-type="Server"
        data-cfg-delete-name="{{if .Hostname}}{{.Hostname}}{{else}}{{.ServiceTag}}{{end}}"
        {{if .ShowDCBack}}data-cfg-delete-dc-id="{{.DataCenterOrbID}}"{{end}}>
        <span class="icon"><i class="fa-solid fa-trash"></i></span>
        <span>Delete</span>
      </button>
      {{end}}
    </div>
  </div>

  {{/*
  Filled by orbital.js (loadPendingChangeBanners) from
  GET /api/v1/change-requests?status=active&orbId=… — the same public endpoint
  any other client would call, per the Change Control UI decision. Stays empty
  when nothing is in flight: an empty banner is a banner nobody reads.
  The subtree orbIds come from the audit tab's data-related-orb-ids, so this and
  the audit panel can never disagree about what "this server" covers.
  */}}
  <div data-pending-changes-for="{{.OrbID}}"></div>

  <div class="grid">
    <div class="cell is-col-span-2 is-row-span-1">
      <article class="box">
        <p class="is-size-4 pb-4">Server Summary</p>
        <div style="overflow-x: auto">
        {{/* data-field-orbid / data-field-values drive the proposed-change field
             marks, same wiring as the maintenance panel below. Rows carrying a
             data-field name get a mark when a change request proposes that
             field; the rows WITHOUT one (Data Center, OOB IP, Rack) are edge
             references rather than editable scalars, so nothing can propose
             them and a mark there would never fire. The names must match the
             Server FormFields in configitems/registry.go — that is what a
             changeset uses as keys. */}}
        {{/* Three columns: field, current value, in review.

             The mark used to sit INSIDE the value cell, which crowded a short
             value against a long annotation while the rest of that column sat
             empty — these values are `Dell` and `5` in a column hundreds of
             pixels wide. Its own column takes that dead space, and every mark
             starts at the same x whatever the value beside it is.

             No header row, so an unmarked table looks exactly as it did: the
             third column is invisible until something occupies it. That is
             what makes the column free — the usual objection to one is the
             permanent empty header, and there isn't one. */}}
        <table class="table is-fullwidth"
               data-field-orbid="{{.OrbID}}"
               data-field-values="{{.SummaryValuesJSON}}">
          {{/* The VALUE column is capped, not the mark column: values here are
               short (`Dell`, `5`), so letting them span half the table only
               pushed the annotation away from the thing it annotates. */}}
          <colgroup><col style="width:1%"><col style="width:28%"><col></colgroup>
          <tbody>
            <tr><td style="white-space:nowrap">Data Center</td><td>{{if .DataCenterName}}{{.DataCenterName}}{{else}}—{{end}}</td><td></td></tr>
            <tr data-field="hostname"><td style="white-space:nowrap">Hostname</td><td>{{if .Hostname}}{{.Hostname}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
            <tr data-field="manufacturer"><td style="white-space:nowrap">Manufacturer</td><td>{{if .Manufacturer}}{{.Manufacturer}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
            <tr data-field="model"><td style="white-space:nowrap">Model</td><td>{{if .Model}}{{.Model}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
            <tr><td style="white-space:nowrap">OOB IP</td><td>{{if .OobIP}}{{.OobIP}}{{else}}—{{end}}</td><td></td></tr>
            <tr data-field="oobMAC"><td style="white-space:nowrap">OOB MAC</td><td>{{if .OobMAC}}{{.OobMAC}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
            <tr><td style="white-space:nowrap">Rack</td><td>{{if .Rack.Name}}{{.Rack.Name}}{{else}}—{{end}}</td><td></td></tr>
            <tr data-field="rackPosition"><td style="white-space:nowrap">Rack Position</td><td>{{if .RackPosition}}{{.RackPosition}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
            <tr data-field="serviceTag"><td style="white-space:nowrap">Service Tag</td><td>{{if .ServiceTag}}{{.ServiceTag}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
          </tbody>
        </table>
        </div>
      </article>
    </div>

    <div class="cell is-row-span-1">
      <article class="box" style="height:100%">
        <p class="is-size-4 mb-4">Metadata</p>
        <div style="overflow-x: auto">
        <table class="table mb-0">
          <tbody>
            <tr><td style="white-space:nowrap;width:1%">Namespace</td><td>{{if .Namespace}}{{.Namespace}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Orb ID</td><td>{{if .OrbID}}{{.OrbID}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Created By</td><td>{{if .CreatedBy}}{{.CreatedBy}}{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Created At</td><td>{{if .CreatedAt}}<span data-timestamp="{{.CreatedAt}}">{{.CreatedAt}}</span>{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Last Updated</td><td>{{if .UpdatedAt}}<span data-timestamp="{{.UpdatedAt}}">{{.UpdatedAt}}</span>{{else}}—{{end}}</td></tr>
            <tr><td style="white-space:nowrap">Last Updated By</td><td>{{if .UpdatedBy}}{{.UpdatedBy}}{{else}}—{{end}}</td></tr>
          </tbody>
        </table>
        </div>
      </article>
    </div>

    <div class="cell is-col-span-3">
      <article class="box pb-2">
        <p class="is-size-4 pb-4">Details</p>
        <div class="tabs is-boxed" id="srv-detail-tabs-{{.DomID}}">
          <ul>
            {{/* data-panel-orbids drives the tab dot: orbital.js lights it from the
                 SAME /api/v1/proposed-changes response the field marks use, so a
                 panel you have not opened still says it has something in flight.
                 DECLARED here rather than scraped from rendered marks — the dot
                 must be right whether or not the panel has rendered. */}}
            <li class="is-active" data-panel="srv-panel-idrac-{{.DomID}}"
                data-panel-orbids="{{.IdracOrbID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-microchip"></i></span><span>iDRAC Settings</span><span class="js-tab-dot"></span></a>
            </li>
            <li data-panel="srv-panel-storage-{{.DomID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-hard-drive"></i></span><span>Storage</span></a>
            </li>
            <li data-panel="srv-panel-network-{{.DomID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-network-wired"></i></span><span>Network</span></a>
            </li>
            <li data-panel="srv-panel-maintenance-{{.DomID}}"
                data-panel-orbids="{{.MaintenanceOrbID}}">
              <a><span class="icon is-small"><i class="fa-solid fa-wrench"></i></span><span>Maintenance</span><span class="js-tab-dot"></span></a>
            </li>
            {{template "audit-tab-li" .}}
          </ul>
        </div>

        <div style="min-height: 300px">

        <div id="srv-panel-idrac-{{.DomID}}">
          {{if .IdracSettings}}
          {{/* data-field-orbid / data-field-values drive the proposed-change
               marks — same wiring as Server Summary above and the maintenance
               panel below; the three tables are one pattern and must not drift.
               The orbId is the CHILD's: an edit to an owned child records the
               child's orbId, never the server's, so a mark here can only fire
               from IdracOrbID. data-field names must match the IdracSettings
               FormFields in configitems/registry.go. */}}
          <table class="table is-fullwidth mt-2"
                 data-field-orbid="{{.IdracOrbID}}"
                 data-field-values="{{.IdracValuesJSON}}">
            <colgroup><col style="width:1%"><col style="width:28%"><col></colgroup>
            <tbody>
              <tr data-field="firmwareVersion"><td style="white-space:nowrap">firmwareVersion</td><td>{{if .IdracSettings.FirmwareVersion}}{{.IdracSettings.FirmwareVersion}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="dhcpEnabled"><td style="white-space:nowrap">dhcpEnabled</td><td>{{if .IdracSettings.DhcpEnabled}}<span class="tag">true</span>{{else}}<span class="tag">false</span>{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="ipmiEnabled"><td style="white-space:nowrap">ipmiEnabled</td><td>{{if .IdracSettings.IpmiEnabled}}<span class="tag">true</span>{{else}}<span class="tag">false</span>{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="lockdownModeEnabled"><td style="white-space:nowrap">lockdownModeEnabled</td><td>{{if .IdracSettings.LockdownModeEnabled}}<span class="tag">true</span>{{else}}<span class="tag">false</span>{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="osToIdracPassThroughEnabled"><td style="white-space:nowrap">osToIdracPassThroughEnabled</td><td>{{if .IdracSettings.OsToIdracPassThroughEnabled}}<span class="tag">true</span>{{else}}<span class="tag">false</span>{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="racadmEnabled"><td style="white-space:nowrap">racadmEnabled</td><td>{{if .IdracSettings.RacadmEnabled}}<span class="tag">true</span>{{else}}<span class="tag">false</span>{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="sshEnabled"><td style="white-space:nowrap">sshEnabled</td><td>{{if .IdracSettings.SshEnabled}}<span class="tag">true</span>{{else}}<span class="tag">false</span>{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="usbManagementPortEnabled"><td style="white-space:nowrap">usbManagementPortEnabled</td><td>{{if .IdracSettings.UsbManagementPortEnabled}}<span class="tag">true</span>{{else}}<span class="tag">false</span>{{end}}</td><td><span class="js-field-mark"></span></td></tr>
            </tbody>
          </table>
          {{else}}
          <p class="has-text-grey p-2">No iDRAC settings discovered yet.</p>
          {{end}}
        </div>

        <div id="srv-panel-storage-{{.DomID}}" style="display:none">
          {{if .StorageControllers}}
          <div style="overflow-x:auto">
          <table class="table is-striped is-hoverable is-fullwidth">
            <thead>
              <tr>
                <th>Controller</th>
                <th>Name</th>
                <th>Manufacturer</th>
                <th>Capacity (GiB)</th>
                <th>Serial</th>
                <th>WWN</th>
              </tr>
            </thead>
            <tbody>
              {{range .StorageControllers}}
              {{$ctrl := .Name}}
              {{range .StorageDevices}}
              <tr>
                <td>{{$ctrl}}</td>
                <td>{{if .Name}}{{.Name}}{{else}}—{{end}}</td>
                <td>{{if .Manufacturer}}{{.Manufacturer}}{{else}}—{{end}}</td>
                <td>{{if .CapacityBytes}}{{.CapacityBytes}}{{else}}—{{end}}</td>
                <td>{{if .SerialNumber}}{{.SerialNumber}}{{else}}—{{end}}</td>
                <td>{{if .WWN}}{{.WWN}}{{else}}—{{end}}</td>
              </tr>
              {{end}}
              {{end}}
            </tbody>
          </table>
          </div>
          {{else}}
          <p class="has-text-grey p-2">No storage discovered yet.</p>
          {{end}}
        </div>

        <div id="srv-panel-network-{{.DomID}}" style="display:none">
          {{if or .NetworkAdapters .MgmtInterfaces}}
          <div style="overflow-x:auto">
          <table class="table is-striped is-hoverable is-fullwidth">
            <thead>
              <tr>
                <th>Adapter</th>
                <th>Port</th>
                <th>MAC</th>
                <th>Type</th>
                <th>Link Speed (Mbps)</th>
                <th>Connected Device</th>
                <th>Device Port</th>
              </tr>
            </thead>
            <tbody>
              {{range .NetworkAdapters}}
              {{$adapter := .Name}}
              {{range .NetworkInterfaces}}
              <tr>
                <td>{{$adapter}}</td>
                <td>{{if .Name}}{{.Name}}{{else}}—{{end}}</td>
                <td>{{if .MacAddress}}<code>{{.MacAddress}}</code>{{else}}—{{end}}</td>
                <td>{{if .PortType}}{{.PortType}}{{else}}—{{end}}</td>
                <td>{{if .LinkSpeedMbps}}{{.LinkSpeedMbps}}{{else}}—{{end}}</td>
                <td>{{if .DeviceName}}{{.DeviceName}}{{if .DeviceRole}} ({{.DeviceRole}}){{end}}{{else}}—{{end}}</td>
                <td>{{if .RemotePort}}<code>{{.RemotePort}}</code>{{else}}—{{end}}</td>
              </tr>
              {{end}}
              {{end}}
              {{range .MgmtInterfaces}}
              <tr>
                <td>—</td>
                <td>{{if .Name}}{{.Name}}{{else}}—{{end}} <span class="tag is-warning is-light">mgmt</span></td>
                <td>{{if .MacAddress}}<code>{{.MacAddress}}</code>{{else}}—{{end}}</td>
                <td>{{if .PortType}}{{.PortType}}{{else}}—{{end}}</td>
                <td>{{if .LinkSpeedMbps}}{{.LinkSpeedMbps}}{{else}}—{{end}}</td>
                <td>{{if .DeviceName}}{{.DeviceName}}{{if .DeviceRole}} ({{.DeviceRole}}){{end}}{{else}}—{{end}}</td>
                <td>{{if .RemotePort}}<code>{{.RemotePort}}</code>{{else}}—{{end}}</td>
              </tr>
              {{end}}
            </tbody>
          </table>
          </div>
          {{else}}
          <p class="has-text-grey p-2">No network adapters discovered yet.</p>
          {{end}}
        </div>

        <div id="srv-panel-maintenance-{{.DomID}}" style="display:none">
          {{if .MaintenanceConfigured}}
          {{/* data-field-orbid / data-field-values drive the proposed-change
               marks: orbital.js reads every panel carrying them, asks
               /api/v1/proposed-changes about those orbIds, and fills the
               js-field-mark slot on any row whose field is proposed. The
               values are the RAW ones, so a proposal that already matches
               current state can be recognised as a no-op and left unmarked. */}}
          {{/* Same three-column shape as Server Summary above — the two tables
               are the same pattern and must not drift apart. */}}
          <table class="table is-fullwidth mt-2"
                 data-field-orbid="{{.MaintenanceOrbID}}"
                 data-field-values="{{.MaintenanceValuesJSON}}">
            <colgroup><col style="width:1%"><col style="width:28%"><col></colgroup>
            <tbody>
              <tr data-field="enabled"><td style="white-space:nowrap">enabled</td><td><span class="tag">{{if .MaintenanceEnabled}}true{{else}}false{{end}}</span></td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="windowStart"><td style="white-space:nowrap">windowStart</td><td>{{if .MaintenanceWindowStart}}{{.MaintenanceWindowStart}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="windowEnd"><td style="white-space:nowrap">windowEnd</td><td>{{if .MaintenanceWindowEnd}}{{.MaintenanceWindowEnd}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
              <tr data-field="reason"><td style="white-space:nowrap">reason</td><td>{{if .MaintenanceReason}}{{.MaintenanceReason}}{{else}}—{{end}}</td><td><span class="js-field-mark"></span></td></tr>
            </tbody>
          </table>
          {{else}}
          <p class="has-text-grey p-2">No maintenance configured.</p>
          {{end}}
        </div>

        {{template "audit-tab-placeholder" .}}

        </div>
      </article>
    </div>
  </div>

</div>

{{if .Actions.Edit}}{{template "edit-modal-server.gohtml" .}}{{end}}

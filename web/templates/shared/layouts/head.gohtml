<meta charset="utf-8">

<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' height='512' rx='80' fill='white'/><g transform='translate(56,56) scale(0.78)'><path fill='%234a4a4a' d='M192 32c0-17.7 14.3-32 32-32C383.1 0 512 128.9 512 288c0 17.7-14.3 32-32 32s-32-14.3-32-32C448 164.3 347.7 64 224 64c-17.7 0-32-14.3-32-32zM60.6 220.6L164.7 324.7l28.4-28.4c-.7-2.6-1.1-5.4-1.1-8.3c0-17.7 14.3-32 32-32s32 14.3 32 32s-14.3 32-32 32c-2.9 0-5.6-.4-8.3-1.1l-28.4 28.4L291.4 451.4c14.5 14.5 11.8 38.8-7.3 46.3C260.5 506.9 234.9 512 208 512C93.1 512 0 418.9 0 304c0-26.9 5.1-52.5 14.4-76.1c7.5-19 31.8-21.8 46.3-7.3zM224 96c106 0 192 86 192 192c0 17.7-14.3 32-32 32s-32-14.3-32-32c0-70.7-57.3-128-128-128c-17.7 0-32-14.3-32-32s14.3-32 32-32z'/></g></svg>">

<script>window.ORBITAL_BASE = '{{.BasePath}}';</script>

{{/* Import map: remaps every ES-module URL to a ?v={{.Version}} variant so
     that a deploy invalidates cached JS in all browsers. ES module
     specifiers are static — `import from './shared.js'` can't be
     templated inside the JS file itself, and browsers cache the resolved
     URL forever. Without this map, orbital.js is cache-busted via ?v=
     on its <script> tag, but its transitive imports of shared.js /
     configitem-editor.js hit stale browser cache, producing "does not
     provide an export named X" errors after a deploy that added exports.
     Keys are the absolute post-resolution URLs (matching what the browser
     computes when resolving relative imports from JS files under
     /static/*), NOT relative paths (which resolve against the HTML
     document, not the importing module). Must appear BEFORE any
     <script type="module"> that would use it — browser fixes the map at
     first-module-load time. */}}
<script type="importmap">
{
  "imports": {
    "{{.BasePath}}/static/shared.js": "{{.BasePath}}/static/shared.js?v={{.Version}}",
    "{{.BasePath}}/static/configitem-editor.js": "{{.BasePath}}/static/configitem-editor.js?v={{.Version}}",
    "{{.BasePath}}/static/bulma-toast.js": "{{.BasePath}}/static/bulma-toast.js?v={{.Version}}",
    "{{.BasePath}}/static/vanilla-jsoneditor/standalone.js": "{{.BasePath}}/static/vanilla-jsoneditor/standalone.js?v={{.Version}}"
  }
}
</script>

<script type="text/javascript" src="{{.BasePath}}/static/datatables/jquery-3.7.1.js"></script>
<script src="{{.BasePath}}/static/htmx-2.0.2.min.js"></script>
<link rel="stylesheet" href="{{.BasePath}}/static/font-awesome-6.6.0/css/all.min.css">

<script type="module">
  import * as bulmaToast from '{{.BasePath}}/static/bulma-toast.js'
  window.bulmaToast = bulmaToast
</script>
<script type="text/javascript" src="{{.BasePath}}/static/modal-fx.min.js"></script>

<script src="{{.BasePath}}/static/datatables/dataTables-2.3.4.js"></script>
<script src="{{.BasePath}}/static/datatables/dataTables-3.2.5.buttons.min.js"></script>
<script src="{{.BasePath}}/static/datatables/buttons-3.2.5.bulma.min.js"></script>
<script src="{{.BasePath}}/static/datatables/buttons-3.2.5.colVis.min.js"></script>
<script src="{{.BasePath}}/static/datatables/buttons-3.2.5.html5.min.js"></script>
<script src="{{.BasePath}}/static/datatables/jszip-3.10.1.min.js"></script>
<script src="{{.BasePath}}/static/datatables/dataTables-3.0.7.responsive.min.js"></script>
<script src="{{.BasePath}}/static/datatables/responsive-3.0.7.bulma.js"></script>
<script src="{{.BasePath}}/static/datatables/dataTables-3.1.1.select.min.js"></script>

<link rel="stylesheet" href="{{.BasePath}}/static/datatables/dataTables-2.3.4.bulma.css">
<script src="{{.BasePath}}/static/datatables/dataTables-2.3.4.bulma.js"></script>
<link rel="stylesheet" href="{{.BasePath}}/static/datatables/buttons-3.2.5.bulma.min.css">
<link rel="stylesheet" href="{{.BasePath}}/static/datatables/responsive-3.0.7.bulma.min.css">
<link rel="stylesheet" href="{{.BasePath}}/static/datatables/select-3.1.1.bulma.min.css">
<link rel="stylesheet" href="{{.BasePath}}/static/css/animate-4.0.0.min.css">

<link rel="stylesheet" href="{{.BasePath}}/static/css/main.css?v={{.Version}}">
<link rel="stylesheet" href="{{.BasePath}}/static/css/modal-fx.css">

{{/* shared.js is NOT loaded directly — orbital.js / orb.js import it as a
     module. Loading it explicitly here AND letting the app modules import
     `./shared.js` causes the browser to fetch it twice (different URLs: with
     and without the `?v=` query) and run all its top-level side-effects
     twice: doubled event listeners, doubled module-level Maps/Sets, every
     handler fires twice. See past bug: post-edit-submit tab restoration broke
     because two afterSwap handlers raced on different copies of state. */}}
{{if eq .UI.AppName "Orbital"}}
<script type="module" src="{{.BasePath}}/static/orbital.js?v={{.Version}}"></script>
{{else}}
<script type="module" src="{{.BasePath}}/static/orb.js?v={{.Version}}"></script>
{{end}}
<script type="module">
  import { JSONEditor } from '{{.BasePath}}/static/vanilla-jsoneditor/standalone.js'
  window.JSONEditor = JSONEditor
</script>

<title>{{if and .PageTitle (ne .PageTitle .UI.AppName)}}{{.PageTitle}} | {{.UI.AppName}}{{else}}{{.UI.AppName}}{{end}}</title>

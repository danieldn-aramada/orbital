{{/*
generic-list.gohtml — the list page for ANY ConfigItem type.

A page heading, a tabs bar, a .tab-content tabpanel, and a DataTable with the
house toolbar.

The heading sits ABOVE the tabs rather than replacing them, which looks like a
one-tab bar with a title over it and is not. `loadGenericTab` appends to
#tablist when a row is opened, so the bar grows; and #tab-summary is what
closing a tab clicks to get back to the list. Replacing it means designing a
new return affordance — tracked in debt.md, deliberately not done here.

This page carries no description line. A list of things does not need a
sentence explaining that it is a list of things.

NOTHING here is per-type: columns come from the view's derived field list, so a
type added to the schema gets this page with no template and no handler.

Rows are rendered server-side rather than fetched by JS. The bespoke pages each
carry their own GraphQL query and tab-opening behaviour in LIST_PAGES; this page
has one query built from the view, so there is nothing per-type for JS to know.
*/}}
{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if and .UI.ShowAuth (not .IsAuthn)}}
        {{template "login-gate.gohtml" .}}
      {{else}}

      <p class="is-size-4 mb-2" data-testid="page-heading">{{.View.Label}}</p>

      <nav class="tabs is-boxed has-text-weight-medium" style="font-size: 14px;">
        <ul id="tablist" role="tablist">
          <li class="tab is-active">
            <a id="tab-summary" data-target="tab-content-generic" role="tab" aria-selected="true" tabindex="0">
              Summary
            </a>
          </li>
        </ul>
      </nav>

      <div class="tab-content" role="tabpanel" id="tab-content-generic">
        {{if .Unavailable}}
        <div class="notification is-warning is-light" data-testid="view-unavailable">
          <p class="has-text-weight-semibold mb-2">This page is unavailable.</p>
          <p class="is-size-7">{{.Unavailable}}</p>
        </div>
        {{else}}
        {{/* Said, not silent — and it states the LIMITATION, not just the count.
             The first wording said "search or filter to narrow the list", which
             is advice that cannot work: search and the filterBy are client-side
             over the rows actually rendered, so neither can reach a row past
             the cap. Someone following it searches, finds nothing, and
             concludes the row does not exist. */}}
        {{if .Truncated}}
        <div class="notification is-info is-light is-size-7" data-testid="list-truncated">
          Showing the first <strong>{{len .Rows}}</strong> of <strong>{{.Total}}</strong>.
          Search and filtering on this page cover only these {{len .Rows}} rows.
          Raise <code>{{.RowCapSetting}}</code> to load more.
        </div>
        {{end}}
        {{/* The filterBy dropdown, rendered HERE rather than built in JS.
             Structure belongs in the template (UI.md); shared.js only moves it
             into the DataTables toolbar and wires `change` to a column search.
             Column index and option list are resolved server-side so an API
             consumer drawing its own table gets the same control for free. */}}
        {{with .FilterBy}}
        <div class="select is-small js-filterBy" data-filter-by-column="{{.Column}}" style="display:none">
          <select id="generic-filter-by" data-testid="generic-filter-by" aria-label="Filter by {{.Label}}">
            <option value="">{{.All}}</option>
            {{range .Options}}<option value="{{.}}">{{.}}</option>{{end}}
          </select>
        </div>
        {{end}}
        {{/* No data-testid here: DataTables CLONES the table for its scroll head
             and foot, copying data-* attributes but not the id — three elements
             would then share one test id and every strict selector would break.
             The id is unique and is what initGenericTable() binds to. */}}
        <table id="generic-table"
               class="table is-striped is-hoverable is-fullwidth is-size-7"
               data-slug="{{.View.Slug}}"
               data-type="{{.View.Type}}"
               data-label="{{.View.Label}}">
          <thead>
            <tr>
              <th>Name</th>
              {{range .Columns}}<th>{{.Label}}</th>{{end}}
              {{range .RefColumns}}<th style="white-space:nowrap">{{.Label}}</th>{{end}}
              {{range .ComputedColumns}}<th style="white-space:nowrap">{{.Label}}</th>{{end}}
              <th>Orb ID</th>
            </tr>
          </thead>
          <tbody>
            {{$slug := .View.Slug}}
            {{$base := .BasePath}}
            {{$cols := .Columns}}
            {{range .Rows}}
            {{/* data-orb-id, because the name is NOT a link and there is no href
                 to read the entity out of. The row IS the handle. */}}
            <tr data-orb-id="{{index . "orbId"}}">
              {{/* PLAIN TEXT, deliberately. This table has DataTables row
                   selection (`select: { style: 'os' }`) and the Copy/Excel/CSV
                   buttons export the selection — so single click is already
                   taken, and double click is what opens a row as a tab. That is
                   why the hand-written tables had no links either; it was forced,
                   not a quirk. A link here would claim a navigation that does not
                   happen (the tab opens on the page you are already on) and would
                   fire selection and opening from one gesture.

                   Reference columns below DO link: those leave for another
                   type's page, where selection is moot. */}}
              <td style="white-space:nowrap">{{index . "name"}}</td>
              {{$row := .}}
              {{range $cols}}<td>{{with index $row .Field}}{{.}}{{else}}—{{end}}</td>{{end}}
              {{range $.RefColumns}}
              {{$rc := .}}
              <td style="white-space:nowrap">
                {{/* No slug means the target type has no page: render the name
                     as text rather than a link to nowhere. */}}
                {{with index $row $rc.Field}}{{if $rc.Slug}}<a href="{{$base}}/{{$rc.Slug}}?open={{index . "orbId"}}">{{index . "name"}}</a>{{else}}{{index . "name"}}{{end}}{{else}}—{{end}}
              </td>
              {{end}}
              {{range $.ComputedColumns}}<td style="white-space:nowrap">{{with index $row .Field}}{{.}}{{else}}—{{end}}</td>{{end}}
              {{/* Plain text, like every other value cell. `<code>` here made one
                   column monospace in a table of sans-serif cells, which is the
                   per-cell differentiation UI.md's list-table rule forbids —
                   every column reads as a different kind of thing. */}}
              <td style="white-space:nowrap">{{index . "orbId"}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
        {{end}}
      </div>

      {{end}}
    </div>
  </main>
{{end}}

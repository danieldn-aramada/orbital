{{/*
clusters.gohtml — the Clusters list, shared by orbital and orb.

See servers.gohtml for why the auth gate is conditional rather than duplicated.
The two former copies also disagreed on page padding (orbital pr-5 pl-5 pt-5
pb-1, orb p-5); p-5 wins because it is what 23 of the 27 page templates use.
*/}}
{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if and .UI.ShowAuth (not .IsAuthn)}}
        {{template "login-gate.gohtml" .}}
      {{else}}

      {{template "hint-banner.gohtml" .}}

      <nav class="tabs is-boxed has-text-weight-medium" style="font-size: 14px;">
        <ul id="tablist" role="tablist">
          <li class="tab is-active">
            <a id="tab-summary" data-target="tab-content-clusters" role="tab" aria-selected="true" tabindex="0">
              Summary
            </a>
          </li>
        </ul>
      </nav>

      <div class="tab-content" role="tabpanel" id="tab-content-clusters">
        <table id="cluster-table" class="table is-striped is-hoverable is-fullwidth is-size-7">
          <thead>
            <tr>
              <th style="width:1%"></th>
              <th>Name</th>
              <th>Data Center</th>
              <th>Provider</th>
              <th>Cluster Type</th>
              <th>K8s Version</th>
              <th>Environment</th>
              <th>CNI</th>
              <th>Nodes</th>
              <th>ID</th>
              <th>Orb ID</th>
            </tr>
          </thead>
        </table>
      </div>

      {{end}}
    </div>
  </main>
{{end}}

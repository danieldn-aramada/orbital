{{/*
generic-detail.gohtml — the BODY of a ConfigItem detail view, for any type.

Fields come from the view's derived list; tabs come from the type's
relationships in the deployed schema. No per-type markup.

There is NO {{define "page"}} here, and that is the design. A ConfigItem is
shown as a TAB on its list page and nowhere else: /{slug}/{orbId} is the url
the tab FETCHES with HX-Request, and it 404s for anyone else. That is what the
hand-written pages did too — their handler was literally called `Tab` and a
non-htmx request was redirected away.

A full page briefly existed (2026-09-29 to 2026-10-05) because the migration
made every type routable. It was never a design anyone chose, and it left two
layouts for one thing plus a list whose rows looked like navigation and opened
a tab. Its heading and breadcrumb lived here; both are redundant inside a tab,
where the tab's own label is the heading and the strip is the way back.
*/}}
{{define "generic-detail-content"}}
      <div class="tab-content">
        {{if .Unavailable}}
        <div class="notification is-warning is-light" data-testid="view-unavailable">
          <p class="has-text-weight-semibold mb-2">This page is unavailable.</p>
          <p class="is-size-7">{{.Unavailable}}</p>
        </div>
        {{else}}

        {{/* The action row, ABOVE everything — where every hand-written detail
             page put it, and where it has to stay: this block is served both as
             a full page and as the tab fragment, so burying the buttons inside
             the Fields box moved them in BOTH. `is-rounded is-link` is the house
             primary (UI.md); the green `is-success` the migration introduced was
             never a colour this project used for Edit. */}}
        <div class="buttons mb-3">
          {{if .Actions.Reload}}
          <button class="button is-rounded is-small is-link js-generic-reload">
            <span class="icon"><i class="fa-solid fa-refresh"></i></span>
            <span>Reload</span>
          </button>
          {{end}}
          {{if and .CanMutate .HasEditable}}
          <button class="button is-rounded is-small is-link" data-generic-edit-id="{{.EditModal.DomID}}">
            <span class="icon"><i class="fa-solid fa-pen-to-square"></i></span>
            <span>Edit</span>
          </button>
          {{end}}
          {{/* Delete uses the SAME attributes, global handler and modal the
               hand-written pages used — only the markup was per-page. */}}
          {{if .CanDelete}}
          <button class="button is-rounded is-small is-danger"
            data-cfg-delete-id="{{.OrbID}}"
            data-cfg-delete-slug="{{.ListSlug}}"
            data-cfg-delete-type="{{.View.Type}}"
            data-cfg-delete-name="{{with .Entity}}{{index . "name"}}{{else}}{{$.OrbID}}{{end}}">
            <span class="icon"><i class="fa-solid fa-trash"></i></span>
            <span>Delete</span>
          </button>
          {{end}}
        </div>

        {{/*
          Filled by loadPendingChangeBanners (orbital.js) when this item, or
          anything in its subgraph, has a change request in flight. Directly under the
          action row and above the fields, because it changes what Edit will do
          — a reader who does not know a change is pending retypes it.

          The subgraph lookup reads data-subgraph-orb-ids off the audit box, which
          is already on the page; only this placeholder was missing.
        */}}
        <div data-pending-changes-for="{{.OrbID}}"></div>

        {{/* Fields LEFT, Metadata RIGHT — the arrangement every hand-written
             detail page had, and nothing about it is per-type: every
             ConfigItem carries the same seven metadata fields. Stacking them
             was a migration simplification, not a consequence of being
             generic, and it pushed the actual configuration a full screen
             down behind provenance nobody opens the page for. Bulma's
             columns collapse on narrow viewports on their own. */}}
        <div class="columns">
        <div class="column is-8">

        <article class="box" style="height:100%">
          <p class="is-size-6 has-text-weight-semibold mb-3">Fields</p>
          {{/*
            data-field-orbid / data-field-values drive the proposed-change field
            marks (loadFieldMarks in orbital.js). Only EDITABLE rows carry
            data-field and a mark slot — a mark on a field nobody can propose
            could never fire, and an empty slot on every reference row would
            just add a column of nothing.
          */}}
          <table class="table is-fullwidth is-size-7" data-testid="generic-fields"
            data-field-orbid="{{.OrbID}}"
            data-field-values="{{.FieldValuesJSON}}">
            <colgroup><col style="width:1%"><col style="width:40%"><col></colgroup>
            <tbody>
              {{range .FieldRows}}
              <tr {{if .Editable}}data-field="{{.Field}}"{{end}}>
                <td style="white-space:nowrap;width:1%">{{.Label}}</td>
                <td>
                  {{- if and .Blob .Value -}}
                  <pre class="is-size-7 mb-0" style="max-height:18rem;overflow:auto">{{.Value}}</pre>
                  {{- else -}}
                  {{- with .Value}}{{.}}{{else}}<span class="has-text-grey">—</span>{{end -}}
                  {{- end -}}
                </td>
                <td>{{if .Editable}}<span class="js-field-mark"></span>{{end}}</td>
              </tr>
              {{end}}
              {{/*
                Single relationships are rows here, not boxes of their own. A
                cluster relates to a data centre, a management cluster, a
                control-plane endpoint and a Tinkerbell IP — four one-row boxes
                would bury the fields they sit beside.
              */}}
              {{range .Refs}}
              <tr>
                <td style="white-space:nowrap;width:1%">{{.Label}}</td>
                {{/* No slug means the target type has no PAGE, so there is
                     nowhere to go — the value renders as text rather than as a
                     link to "//<orbId>". Promoting that type to a page is the
                     one change that turns these into links. */}}
                <td>{{if .Slug}}<a href="{{$.BasePath}}/{{.Slug}}?open={{.OrbID}}">{{.Name}}</a>{{else}}{{.Name}}{{end}}</td>
                <td></td>
              </tr>
              {{end}}
            </tbody>
          </table>
        </article>

        {{/*
          Metadata is its own box for the same reason every hand-written detail
          page gave it one: identity and provenance are orbital's record OF the
          item, not fields of it, and mixing them into the field list invites
          someone to try editing `version`.

          Rows are derived — .View.Meta is the ConfigItem interface, read from
          the deployed schema — so a field added to the interface appears here
          without a template change.
        */}}
        </div>
        <div class="column is-4">

        {{if .Meta}}
        <article class="box" style="height:100%" data-testid="generic-meta">
          <p class="is-size-6 has-text-weight-semibold mb-3">Metadata</p>
          <table class="table is-fullwidth is-size-7">
            <tbody>
              {{range .Meta}}
              <tr>
                <td style="white-space:nowrap;width:1%">{{.Label}}</td>
                <td>
                  {{- if not .Value -}}<span class="has-text-grey">—</span>
                  {{- else if .IsTimestamp -}}<span data-timestamp="{{.Value}}">{{.Value}}</span>
                  {{- else -}}{{.Value}}{{- end -}}
                </td>
              </tr>
              {{end}}
            </tbody>
          </table>
        </article>
        {{end}}

        </div>
        </div>

        {{/*
          Everything below the fold is ONE tabbed box: subgraph members, then
          relationship tables, then the audit log.

          Ten stacked boxes made a Server page 2,854px — 3.2 screens — and you
          scrolled past Storage Controllers to reach Network Interfaces. Tabs
          were how every hand-written page did it, and "put the children in a
          tab strip" is as per-type-free as stacking them was: a type with one
          child gets one tab, a type with eight gets eight.

          initDetailTabs (shared.js) wires this: each <li> names its panel via
          data-panel, the panel is a SIBLING of the tabs div, and the audit tab
          is the one carrying data-orb-id — which also makes the audit log load
          on CLICK rather than with every page.

          The js-tab-dot span is lit by renderTabDots for a panel holding a
          pending proposed change, so an unopened tab still says there is
          something in it. Without it, tabbing would re-hide exactly what the
          field marks exist to surface.
        */}}
        {{if or .Inline .Tabs .Actions.ShowAuditTab}}
        <article class="box pb-2" data-testid="generic-detail-tabs">
          <div class="tabs is-boxed has-text-weight-medium" style="font-size:14px"
               id="generic-detail-tabs-{{.DomID}}">
            <ul>
              {{range $i, $o := .Inline}}
              <li {{if eq $i 0}}class="is-active"{{end}} data-panel="gpanel-{{$.DomID}}-owned-{{$i}}">
                <a><span>{{$o.Label}}</span><span class="js-tab-dot"></span></a>
              </li>
              {{end}}
              {{range $i, $t := .Tabs}}
              <li {{if and (not $.Inline) (eq $i 0)}}class="is-active"{{end}} data-panel="gpanel-{{$.DomID}}-tab-{{$i}}">
                <a><span>{{$t.Label}}</span><span class="js-tab-dot"></span></a>
              </li>
              {{end}}
              {{if .Actions.ShowAuditTab}}
              <li {{if and (not .Inline) (not .Tabs)}}class="is-active"{{end}}
                  data-panel="{{.AuditPanelID}}"
                  data-orb-id="{{.OrbID}}"
                  data-subgraph-orb-ids="{{.SubgraphOrbIDsCSV}}">
                <a><span>Audit Log</span></a>
              </li>
              {{end}}
            </ul>
          </div>

        {{range $i, $o := .Inline}}
        <div id="gpanel-{{$.DomID}}-owned-{{$i}}" {{if ne $i 0}}style="display:none"{{end}}>
        {{with $o}}
        <article class="pt-3" data-testid="generic-owned" data-field="{{.Label}}">
          <p class="is-size-6 has-text-weight-semibold mb-3">{{.Label}}</p>
          {{if .Fields}}
          <table class="table is-fullwidth is-size-7"
            data-field-orbid="{{.OrbID}}"
            data-field-values="{{.FieldValuesJSON}}">
            <colgroup><col style="width:1%"><col style="width:40%"><col></colgroup>
            <tbody>
              {{range .Fields}}
              <tr {{if .Field}}data-field="{{.Field}}"{{end}}>
                <td style="white-space:nowrap;width:1%">{{.Label}}</td>
                <td>{{if .Value}}{{.Value}}{{else}}<span class="has-text-grey">—</span>{{end}}</td>
                <td>{{if .Field}}<span class="js-field-mark"></span>{{end}}</td>
              </tr>
              {{end}}
            </tbody>
          </table>
          {{end}}
          {{range .Children}}
          <p class="is-size-7 has-text-weight-semibold mt-3 mb-1">{{.Label}}</p>
          {{if .OrbID}}
          <table class="table is-fullwidth is-size-7 mb-0"
            data-field-orbid="{{.OrbID}}"
            data-field-values="{{.FieldValuesJSON}}">
            <colgroup><col style="width:1%"><col style="width:40%"><col></colgroup>
            <tbody>
              {{range .Fields}}
              <tr {{if .Field}}data-field="{{.Field}}"{{end}}>
                <td style="white-space:nowrap;width:1%">{{.Label}}</td>
                <td>{{if .Value}}{{.Value}}{{else}}<span class="has-text-grey">—</span>{{end}}</td>
                <td>{{if .Field}}<span class="js-field-mark"></span>{{end}}</td>
              </tr>
              {{end}}
            </tbody>
          </table>
          {{else}}
          <p class="has-text-grey is-size-7">Not configured.</p>
          {{end}}
          {{end}}
        </article>
        {{end}}
        </div>
        {{end}}

        {{range $i, $t := .Tabs}}
        <div id="gpanel-{{$.DomID}}-tab-{{$i}}" {{if or $.Inline (ne $i 0)}}style="display:none"{{end}}>
        {{with $t}}
        <article class="pt-3" data-testid="generic-tab" data-field="{{.Field}}">
          <p class="is-size-6 has-text-weight-semibold mb-3">{{.Label}}</p>
          {{if not .Rows}}
          <p class="has-text-grey is-size-7">None.</p>
          {{else}}
          <div class="table-container">
            <table class="table is-striped is-hoverable is-fullwidth is-size-7">
              <thead>
                <tr>
                  <th style="white-space:nowrap">Name</th>
                  {{range .Columns}}<th style="white-space:nowrap">{{.Label}}</th>{{end}}
                  {{range .RefColumns}}<th style="white-space:nowrap">{{.Label}}</th>{{end}}
                  {{range .ComputedColumns}}<th style="white-space:nowrap">{{.Label}}</th>{{end}}
                  <th style="white-space:nowrap">Orb ID</th>
                </tr>
              </thead>
              <tbody>
                {{$slug := .Slug}}
                {{$cols := .Columns}}
                {{$refs := .RefColumns}}
                {{$cc := .ComputedColumns}}
                {{$fv := .FieldValues}}
                {{$editable := .Editable}}
                {{range .Rows}}
                {{/* The proposed-change marks, at ROW scope.
                     Every other marked surface puts data-field-orbid on the
                     TABLE because one table is one entity. Here each ROW is a
                     different entity, so the attributes move down a level —
                     and loadFieldMarks needs no change at all, because it
                     already walks [data-field-orbid] then [data-field] inside
                     it. One shape, two depths, rather than a second code
                     path. */}}
                {{$orbId := index . "orbId"}}
                <tr data-field-orbid="{{$orbId}}" data-field-values="{{index $fv $orbId}}">
                  <td style="white-space:nowrap">{{if $slug}}<a href="{{$.BasePath}}/{{$slug}}?open={{$orbId}}">{{index . "name"}}</a>{{else}}{{index . "name"}}{{end}}</td>
                  {{$row := .}}
                  {{range $cols}}
                  {{$f := .Field}}
                  <td {{if index $editable $f}}data-field="{{$f}}"{{end}} style="white-space:nowrap">
                    {{with index $row $f}}{{.}}{{else}}—{{end}}{{if index $editable $f}}<span class="js-field-mark"></span>{{end}}
                  </td>
                  {{end}}
                  {{range $refs}}
                  {{$rc := .}}
                  <td style="white-space:nowrap">
                    {{/* Same rule one level down: a reference column whose target
                         type has no page renders as text. */}}
                    {{with index $row $rc.Field}}{{if $rc.Slug}}<a href="{{$.BasePath}}/{{$rc.Slug}}?open={{index . "orbId"}}">{{index . "name"}}</a>{{else}}{{index . "name"}}{{end}}{{else}}—{{end}}
                  </td>
                  {{end}}
                  {{range $cc}}<td style="white-space:nowrap">{{with index $row .Field}}{{.}}{{else}}—{{end}}</td>{{end}}
                  <td style="white-space:nowrap">{{index . "orbId"}}</td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          {{end}}
        </article>
        {{end}}
        </div>
        {{end}}

        {{/*
          Audit Log, as the last TAB rather than a tenth box.
          
          No data-generic-audit here any more: that attribute drove
          initGenericAudit, which loaded the panel with every page render
          because a stacked box has no click to hang it on. As a tab,
          initDetailTabs loads it when the tab is activated — one request
          saved on every detail view nobody opens the audit for.

          data-orb-id and data-subgraph-orb-ids live on the TAB (that is how
          initDetailTabs identifies which one is the audit tab); a change to
          a subgraph member records the CHILD's orbId, so asking about the parent
          alone would report nothing while its settings were being rewritten.
        */}}
        {{if .Actions.ShowAuditTab}}
        <div id="{{.AuditPanelID}}" {{if or .Inline .Tabs}}style="display:none"{{end}}
             data-testid="generic-audit"></div>
        {{end}}

        </article>
        {{end}}

        {{/* The edit modal lives INSIDE the shared body, not in the page block.
             This block is served both as a full page and as the tab fragment,
             and a modal rendered outside it shipped only with the page — so the
             Edit button inside a tab found no `edit-modal-generic-<id>` to open,
             did nothing, and raised no error. The old hand-written fragment
             (`server-tab.gohtml`) rendered its modal inside itself for exactly
             this reason. The opener is a delegated click handler that resolves
             the modal by id at click time, so nothing else has to change.

             Bulma modals are position:fixed, so nesting one inside the panel
             does not constrain it; a hidden tab's modal is unreachable, which
             is correct — its Edit button is unreachable too. */}}
        {{if and .CanMutate .HasEditable}}
        {{template "edit-modal.gohtml" .EditModal}}
        {{end}}

        {{end}}
      </div>
{{end}}

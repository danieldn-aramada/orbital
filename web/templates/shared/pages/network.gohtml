{{/*
network.gohtml — the Network Devices list, shared by orbital and orb.

Orb serves network devices too (decision 2026-09-23), so this page lives in
shared/pages alongside servers and clusters. See servers.gohtml for why the
auth gate is conditional on .UI.ShowAuth rather than duplicated per app.
*/}}
{{define "page"}}
  <main class="app-main-grid">
    <div class="app-menu">
      {{template "menu.gohtml" .}}
    </div>
    <div class="app-main p-5">
      {{if and .UI.ShowAuth (not .IsAuthn)}}
        {{template "login-gate.gohtml" .}}
      {{else}}

      {{template "hint-banner.gohtml" .}}

      <nav class="tabs is-boxed has-text-weight-medium" style="font-size: 14px;">
        <ul id="tablist" role="tablist">
          <li class="tab is-active">
            <a id="tab-summary" data-target="tab-content-network" role="tab" aria-selected="true" tabindex="0">
              Summary
            </a>
          </li>
        </ul>
      </nav>

      <div class="tab-content" role="tabpanel" id="tab-content-network">
        <table id="network-device-table" class="table is-striped is-hoverable is-fullwidth is-size-7">
          <thead>
            <tr>
              <th>Name</th>
              <th>Data Center</th>
              <th>Rack</th>
              <th>Role</th>
              <th>Manufacturer</th>
              <th>Model</th>
              <th>Serial</th>
              <th>MAC</th>
              <th>Servers</th>
              <th>Devices</th>
              <th>Orb ID</th>
            </tr>
          </thead>
        </table>
      </div>

      {{end}}
    </div>
  </main>
{{end}}

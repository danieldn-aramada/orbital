{{/*
create-modal.gohtml — the New-node form, for ANY ConfigItem type with a page.

Generated from the view: scalars from the editable set, relationships from the
schema's NON-NULL edges, identity from the type's `orbIdPattern`, the unit from
the same members the editor writes. No per-type markup, and adding a type adds
no template.

A typed form rather than a blank JSON editor, deliberately. The edit modal works
because its tree is PREFILLED — empty it would offer no affordance and no
discoverability, and a required relationship would be an orbId typed from
memory. Infrahub generates its create form from the schema for the same reason.
*/}}
{{define "create-modal.gohtml"}}
<div id="create-modal-{{.DomID}}" class="modal modal-fx-3dRotateFromBottom" data-kind="{{.Kind}}"
     data-orbid-template="{{.OrbIDTemplate}}" data-namespace-from="{{.NamespaceFrom}}"
     {{if .NamespaceInput}}data-namespace-input="true"{{end}}>
  <div class="modal-background"></div>
  <div class="modal-content modal-card is-large">
    <header class="modal-card-head">
      <p class="modal-card-title">New {{.Label}}</p>
      <button class="delete" aria-label="close" data-modal-close></button>
    </header>

    <section class="modal-card-body">
      {{if .Unavailable}}
      <div class="notification is-warning is-light" data-testid="create-unavailable">
        <p class="is-size-7">{{.Unavailable}}</p>
      </div>
      {{else}}

      {{/* The identity, shown before it is committed to. Empty until every
           placeholder the pattern needs has a value — a partial id is worse
           than none, because it would collide with every other node missing
           the same field. */}}
      <div class="field">
        <label class="label is-size-7">Orb ID</label>
        <p class="is-size-7 has-text-grey" id="create-orbid-{{.DomID}}"
           data-testid="create-orbid">—</p>
      </div>

      {{/* The concrete type, on an INTERFACE page. Rendered even when there is
           one option: it then states what is being created rather than asking,
           and the form does not change shape the day a second implementation
           lands. Each option carries its OWN orbId pattern — a second type need
           not share the first's. */}}
      {{if .Types}}
      <div class="field">
        <label class="label is-size-7">
          Type <span class="has-text-danger">*</span>
        </label>
        <div class="select is-small is-fullwidth">
          <select data-create-type-pick data-testid="create-type">
            {{range .Types}}
            <option value="{{.Kind}}" data-orbid-template="{{.OrbIDTemplate}}">{{.Label}}</option>
            {{end}}
          </select>
        </div>
      </div>
      {{end}}

      {{/* Typed, and ONLY for a root — a type with a required parent inherits
           its namespace from that parent's orbId and must never be asked.
           Sits above the relations because it is the first thing the identity
           needs: the Orb ID preview stays blank until it has a value. */}}
      {{if .NamespaceInput}}
      <div class="field">
        <label class="label is-size-7">
          Namespace <span class="has-text-danger">*</span>
        </label>
        <input class="input is-small" type="text" data-create-namespace
               data-testid="create-namespace" value="" placeholder="e.g. houston">
        <p class="help is-size-7">
          One namespace holds one {{.Label}}. It prefixes every Orb ID beneath this
          one and cannot be changed afterwards.
        </p>
      </div>
      {{end}}

      {{range .Relations}}
      <div class="field">
        <label class="label is-size-7">
          {{.Label}}{{if .Required}} <span class="has-text-danger">*</span>{{end}}
        </label>
        <div class="select is-small is-fullwidth">
          <select data-create-rel="{{.Field}}" {{if .Required}}required{{end}}>
            <option value="">— choose a {{.Label}} —</option>
            {{range .Options}}<option value="{{.OrbID}}">{{.Name}}</option>{{end}}
          </select>
        </div>
      </div>
      {{end}}

      {{range .Fields}}
      <div class="field">
        <label class="label is-size-7">
          {{.Label}}{{if .Identity}} <span class="has-text-danger">*</span>{{end}}
        </label>
        {{/* The control follows the SCALAR TYPE. A Boolean rendered as a text
             box produces the string "false", which DGraph refuses — and lets
             someone type "flase". */}}
        {{if eq .Type "Boolean"}}
        <div class="select is-small is-fullwidth">
          <select data-create-field="{{.Field}}" data-create-type="Boolean">
            <option value=""{{if eq .Default ""}} selected{{end}}>—</option>
            <option value="true"{{if eq .Default "true"}} selected{{end}}>true</option>
            <option value="false"{{if eq .Default "false"}} selected{{end}}>false</option>
          </select>
        </div>
        {{else}}
        <input class="input is-small"
               type="{{if or (eq .Type "Int") (eq .Type "Int64") (eq .Type "Float")}}number{{else}}text{{end}}"
               data-create-field="{{.Field}}" data-create-type="{{.Type}}"
               value="{{.Default}}" placeholder="{{.Hint}}"
               {{if .Identity}}data-create-identity="1" required{{end}}>
        {{end}}
      </div>
      {{end}}

      {{/* The unit. Created in the SAME nested mutation as its parent, which is
           the one nesting DGraph performs atomically — so a failure leaves
           nothing behind rather than a half-made server. */}}
      {{range .Unit}}
      <hr class="my-4">
      <p class="is-size-7 has-text-weight-semibold mb-2">{{.Label}}</p>
      {{$child := .Field}}{{$childTmpl := .OrbIDTemplate}}
      {{range .Fields}}
      <div class="field">
        <label class="label is-size-7 has-text-grey">{{.Label}}</label>
        {{if eq .Type "Boolean"}}
        <div class="select is-small is-fullwidth">
          <select data-create-child="{{$child}}" data-create-field="{{.Field}}"
                  data-create-type="Boolean" data-child-orbid-template="{{$childTmpl}}">
            <option value=""{{if eq .Default ""}} selected{{end}}>—</option>
            <option value="true"{{if eq .Default "true"}} selected{{end}}>true</option>
            <option value="false"{{if eq .Default "false"}} selected{{end}}>false</option>
          </select>
        </div>
        {{else}}
        <input class="input is-small"
               type="{{if or (eq .Type "Int") (eq .Type "Int64") (eq .Type "Float")}}number{{else}}text{{end}}"
               data-create-child="{{$child}}" data-create-field="{{.Field}}"
               data-create-type="{{.Type}}" value="{{.Default}}"
               placeholder="{{.Hint}}" data-child-orbid-template="{{$childTmpl}}">
        {{end}}
      </div>
      {{end}}
      {{end}}

      {{/* Per-implementation fields. Rendered for EVERY type and shown only for
           the selected one, so switching type does not re-fetch and the shared
           fields above keep whatever was typed into them. */}}
      {{range .Types}}
      <div data-create-type-fields="{{.Kind}}" style="display:none">
        {{range .Fields}}
        <div class="field">
          <label class="label is-size-7">
            {{.Label}}{{if .Identity}} <span class="has-text-danger">*</span>{{end}}
          </label>
          {{if eq .Type "Boolean"}}
          <div class="select is-small is-fullwidth">
            <select data-create-field="{{.Field}}" data-create-type="Boolean">
              <option value=""{{if eq .Default ""}} selected{{end}}>—</option>
              <option value="true"{{if eq .Default "true"}} selected{{end}}>true</option>
              <option value="false"{{if eq .Default "false"}} selected{{end}}>false</option>
            </select>
          </div>
          {{else}}
          <input class="input is-small"
                 type="{{if or (eq .Type "Int") (eq .Type "Int64") (eq .Type "Float")}}number{{else}}text{{end}}"
                 data-create-field="{{.Field}}" data-create-type="{{.Type}}"
                 value="{{.Default}}" placeholder="{{.Hint}}"
                 {{if .Identity}}data-create-identity="1"{{end}}>
          {{end}}
        </div>
        {{end}}
      </div>
      {{end}}

      {{/* Repeating rows: a LIST member created alongside its parent, in the
           SAME nested mutation. The row markup lives in a <template> and is
           cloned by JS — page structure belongs here, not built in script.

           `{parent.x}` in the orbId template is filled from the form's ROOT
           inputs; a bare `{x}` from the row's own. For repeating rows that is
           the difference between distinct ids and one id repeated. */}}
      {{range .Repeating}}
      <hr class="my-4">
      <div class="is-flex is-align-items-center mb-2" style="gap:0.75rem">
        <p class="is-size-7 has-text-weight-semibold">{{.Label}}</p>
        <button class="button is-small is-rounded is-link is-outlined"
                data-create-add-row="{{.Field}}" data-testid="create-add-row">
          <span class="icon"><i class="fa-solid fa-plus"></i></span>
          <span>Add</span>
        </button>
      </div>
      <div data-create-rows="{{.Field}}"></div>
      <template data-create-row-template="{{.Field}}">
        <div class="box p-3 mb-2" data-create-row="{{.Field}}"
             data-row-orbid-template="{{.OrbIDTemplate}}">
          <div class="is-flex is-justify-content-space-between is-align-items-start mb-2">
            {{/* Labelled like the root form's identity preview. Unlabelled it
                 reads as a stray placeholder rather than the thing the row is
                 about to be called. */}}
            <div class="field mb-0">
              <label class="label is-size-7 mb-1">Orb ID</label>
              <p class="is-size-7 has-text-grey" data-create-row-orbid
                 data-testid="create-row-orbid">—</p>
            </div>
            <button class="delete is-small" data-create-remove-row aria-label="remove"></button>
          </div>
          {{$rowField := .Field}}
          {{range .Fields}}
          <div class="field">
            {{/* Same weight as the root form's labels. A repeating row is a
                 node being created, not an annotation on one — greying it
                 reads as secondary, and the reader types into it just as
                 much. */}}
            <label class="label is-size-7">
              {{.Label}}{{if .Identity}} <span class="has-text-danger">*</span>{{end}}
            </label>
            {{if eq .Type "Boolean"}}
            <div class="select is-small is-fullwidth">
              <select data-create-row-field="{{.Field}}" data-create-type="Boolean">
                <option value=""{{if eq .Default ""}} selected{{end}}>—</option>
                <option value="true"{{if eq .Default "true"}} selected{{end}}>true</option>
                <option value="false"{{if eq .Default "false"}} selected{{end}}>false</option>
              </select>
            </div>
            {{else}}
            <input class="input is-small"
                   type="{{if or (eq .Type "Int") (eq .Type "Int64") (eq .Type "Float")}}number{{else}}text{{end}}"
                   data-create-row-field="{{.Field}}" data-create-type="{{.Type}}"
                   value="{{.Default}}" placeholder="{{.Hint}}"
                   {{if .Identity}}data-create-identity="1" required{{end}}>
            {{end}}
          </div>
          {{end}}
        </div>
      </template>
      {{end}}

      <div class="notification is-danger is-light is-size-7 mt-4"
           id="create-error-{{.DomID}}" style="display:none"
           data-testid="create-error"></div>
      {{end}}
    </section>

    <footer class="modal-card-foot is-flex is-align-items-center" style="gap:0.75rem;">
      {{if not .Unavailable}}
      <button class="button is-rounded is-small is-link" id="create-submit-{{.DomID}}"
              data-testid="create-submit">Create</button>
      {{end}}
      <button class="button is-rounded is-small" data-modal-close>Cancel</button>
    </footer>
  </div>
</div>
{{end}}

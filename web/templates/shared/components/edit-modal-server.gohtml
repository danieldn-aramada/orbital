<div id="edit-modal-srv-{{.DomID}}"
  class="modal modal-fx-3dRotateFromBottom"
  data-current-user="{{.CurrentUser}}"
  data-version="{{.Version}}"
  data-orb-id="{{.OrbID}}"
  data-idrac-orb-id="{{.IdracOrbID}}"
  data-idrac-version="{{.IdracVersion}}"
  data-reload-url="/servers/{{.OrbID}}{{if .ShowDCBack}}?dcCtx=1{{end}}"
  data-reload-target="{{if .ShowDCBack}}tab-content-{{.DataCenterDomID}}{{else}}tab-content-srv-{{.DomID}}{{end}}">
  <div class="modal-background"></div>
  <div class="modal-content modal-card is-large">
    <header class="modal-card-head">
      <p class="modal-card-title">Edit Server</p>
      <button class="delete" aria-label="close" data-srv-modal-close="{{.DomID}}"></button>
    </header>
    <section class="modal-card-body">
      <div id="srv-json-editor-{{.DomID}}" style="min-height:200px"></div>
    </section>
    <footer class="modal-card-foot is-flex is-align-items-center" style="gap:0.75rem;">
      <div class="buttons" style="margin-bottom:0;">
        <button class="button is-success" id="srv-edit-submit-{{.DomID}}">Save</button>
        <button class="button" data-srv-modal-close="{{.DomID}}">Cancel</button>
      </div>
      <span id="srv-edit-error-{{.DomID}}" class="has-text-danger is-size-7" style="display:none; flex:1;"></span>
    </footer>
  </div>
</div>
<script type="application/json" id="srv-edit-data-{{.DomID}}">{{.EditDataJSON}}</script>

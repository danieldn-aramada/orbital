{{/*
edit-modal.gohtml — the ONE edit modal, for every parent ConfigItem family.

Render context is component.EditModal, built by the page handler. Callers pass
it explicitly: {{template "edit-modal.gohtml" .EditModal}}.

Adding a new parent family does NOT mean copying this file. It means building an
EditModal in the handler and adding one opener in orbital.js keyed on the same
Prefix. See docs/playbooks/add-configitem.md.
*/}}
{{define "edit-modal.gohtml"}}
<div id="edit-modal-{{.Prefix}}-{{.DomID}}"
  class="modal modal-fx-3dRotateFromBottom"
  data-current-user="{{.CurrentUser}}"
  data-version="{{.Version}}"
  data-orb-id="{{.OrbID}}"
  data-views-hash="{{.ViewsHash}}"
  {{- if .Typename}}
  data-typename="{{.Typename}}"
  {{- end}}
  {{- if .IdracOrbID}}
  data-idrac-orb-id="{{.IdracOrbID}}"
  data-idrac-version="{{.IdracVersion}}"
  {{- end}}
  {{- if .ReloadURL}}
  data-reload-url="{{.ReloadURL}}"
  data-reload-target="{{.ReloadTarget}}"
  {{- end}}>
  <div class="modal-background"></div>
  <div class="modal-content modal-card is-large">
    <header class="modal-card-head">
      <p class="modal-card-title">{{.Title}}</p>
      <button class="delete" aria-label="close" data-modal-close></button>
    </header>
    <section class="modal-card-body">
      {{- if .EditorUnavailable}}
      <div class="notification is-warning is-light" data-testid="editor-unavailable">
        <p class="has-text-weight-semibold mb-2">The editor is unavailable.</p>
        <p class="is-size-7">{{.EditorUnavailable}}</p>
      </div>
      {{- else}}
      {{- if .CapNotice}}
      <div class="notification is-info is-light py-2 px-3 mb-3" data-testid="editor-cap-notice">
        <p class="is-size-7">{{.CapNotice}}</p>
      </div>
      {{- end}}
      {{- range $rel := .Relations}}
      {{/* Chosen, not typed — so a select, not a key in the JSON tree below. */}}
      <div class="field">
        <label class="label is-size-7">{{.Label}}</label>
        <div class="select is-small is-fullwidth">
          <select data-edit-rel="{{.Field}}" data-edit-rel-current="{{.Current}}"
                  data-testid="edit-rel-{{.Field}}">
            <option value="">— none —</option>
            {{- range .Options}}
            <option value="{{.OrbID}}" {{if eq .OrbID $rel.Current}}selected{{end}}>{{.Name}}</option>
            {{- end}}
          </select>
        </div>
      </div>
      {{- end}}
      {{- range $ml := .MemberLists}}
      {{/* Rows are added and deleted here only through these controls, never by
           editing the JSON array; a delete is previewed before Save. New-row
           inputs are cloned from the page's <template>, which needs page data. */}}
      <div class="mb-4" data-edit-member-list="{{$ml.Field}}" data-preview-url="{{$ml.PreviewURL}}"
           data-testid="edit-member-list-{{$ml.Field}}">
        <div class="is-flex is-align-items-center mb-2" style="gap:0.75rem">
          <p class="is-size-7 has-text-weight-semibold">{{$ml.Label}}</p>
          {{- if $ml.CanAdd}}
          <button class="button is-small is-rounded is-link is-outlined"
                  data-edit-add-row="{{$ml.Field}}" data-testid="edit-add-row">
            <span class="icon"><i class="fa-solid fa-plus"></i></span>
            <span>Add</span>
          </button>
          {{- end}}
        </div>
        {{- range $row := $ml.Rows}}
        <div class="box p-3 mb-2" data-edit-member-row data-row-orb-id="{{$row.OrbID}}"
             data-row-kind="{{$ml.RowKind}}" data-row-version="{{$row.Version}}">
          <div class="is-flex is-justify-content-space-between is-align-items-center">
            <p class="is-size-7 has-text-weight-semibold">{{with $row.Name}}{{.}}{{else}}{{$row.OrbID}}{{end}}</p>
            {{- if $ml.CanRemove}}
            <label class="checkbox is-size-7 has-text-danger">
              <input type="checkbox" data-edit-delete-row data-testid="edit-delete-row"> Delete
            </label>
            {{- end}}
          </div>
          {{- range $rr := $row.Relations}}
          <div class="field mt-2">
            <label class="label is-size-7">{{$rr.Label}}</label>
            <div class="select is-small is-fullwidth">
              <select data-edit-row-rel="{{$rr.Field}}" data-row-orb-id="{{$row.OrbID}}"
                      data-edit-rel-current="{{$rr.Current}}"
                      data-testid="edit-row-rel-{{$rr.Field}}">
                {{- if not $rr.Required}}
                <option value="">— none —</option>
                {{- end}}
                {{- range $rr.Options}}
                <option value="{{.OrbID}}" {{if eq .OrbID $rr.Current}}selected{{end}}>{{.Name}}</option>
                {{- end}}
              </select>
            </div>
          </div>
          {{- end}}
          <div class="mt-2 is-size-7" data-edit-delete-preview data-testid="edit-delete-preview" style="display:none"></div>
        </div>
        {{- end}}
        <div data-edit-new-rows="{{$ml.Field}}"></div>
      </div>
      {{- end}}
      <div id="{{.Prefix}}-json-editor-{{.DomID}}" style="min-height:200px"></div>
      {{- end}}
    </section>
    <footer class="modal-card-foot is-flex is-align-items-center" style="gap:0.75rem;">
      <div class="buttons" style="margin-bottom:0;">
        {{- if not .EditorUnavailable}}
        <button class="button is-success" id="{{.Prefix}}-edit-submit-{{.DomID}}">Save</button>
        {{- end}}
        <button class="button" data-modal-close>{{if .EditorUnavailable}}Close{{else}}Cancel{{end}}</button>
      </div>
      <span id="{{.Prefix}}-edit-error-{{.DomID}}" class="has-text-danger is-size-7" style="display:none; flex:1;"></span>
    </footer>
  </div>
</div>
<script type="application/json" id="{{.Prefix}}-edit-data-{{.DomID}}">{{.EditDataJSON}}</script>
<script type="application/json" id="{{.Prefix}}-edit-targets-{{.DomID}}">{{.EditTargetsJSON}}</script>
{{end}}
